{
  "name": "bjsmith.xyz",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "workspaces": [
    "admin",
    "shared"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "sharp": "$sharp"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/verify-travel-build.mjs && node scripts/verify-breadcrumb-build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test",
    "test:live": "node scripts/verify-live.mjs",
    "test:travel-clock": "node scripts/verify-travel-clock.mjs",
    "verify": "npm test && npm run build && npm run test:travel-clock && npm run build --workspace @beek/admin"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@beek/shared": "*",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.1.3",
    "leaflet": "^1.9.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "jsdom": "^30.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
