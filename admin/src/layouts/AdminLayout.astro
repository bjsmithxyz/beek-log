---
import '../styles/global.css';
import Breadcrumb from '../components/Breadcrumb.astro';
import Footer from '../components/Footer.astro';
import { siteName, themeColors } from '../data/site';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  title?: string;
  breadcrumbs?: BreadcrumbItem[];
}
const {
  title = 'admin',
  breadcrumbs = [{ label: '~/admin', href: '/' }],
} = Astro.props;
const user = Astro.locals.user;
const fullTitle = title === 'admin' ? siteName : `${title} | ${siteName}`;

// Resolved on the server, not by a before-paint inline script. The admin CSP
// deliberately withholds 'unsafe-inline' from script-src — unlike the public
// site, which grants it — so any such script is blocked and the stored
// preference never applies. Being SSR, this surface can simply render the
// answer. The cookie is written by the footer toggle in Footer.astro.
const theme = Astro.cookies.get('theme')?.value === 'light' ? 'light' : 'dark';
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content={theme === 'light' ? themeColors.light : themeColors.dark} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">skip to content</a>
    <div class="page-wrapper">
      <div class="breadcrumb-row admin-container">
        <Breadcrumb items={breadcrumbs} />
      </div>
      <main class="admin-main" id="main-content" tabindex="-1">
        <div class="admin-container">
          <slot />
        </div>
      </main>
      <Footer user={user} />
    </div>
  </body>
</html>
