---
import '../styles/global.css';
import Breadcrumb from '../components/Breadcrumb.astro';
import Footer from '../components/Footer.astro';
import { siteName, themeColor, publicSite } from '../data/site';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  title?: string;
  breadcrumbs?: BreadcrumbItem[];
}
const {
  title = 'admin',
  breadcrumbs = [{ label: '~/admin', href: publicSite }],
} = Astro.props;
const fullTitle = title === 'admin' ? siteName : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content={themeColor} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">skip to content</a>
    <div class="page-wrapper">
      <div class="breadcrumb-row admin-container">
        <div class="breadcrumb-row-inner">
          <Breadcrumb items={breadcrumbs} />
          <slot name="chrome" />
        </div>
      </div>
      <main class="admin-main" id="main-content" tabindex="-1">
        <div class="admin-container">
          <slot />
        </div>
      </main>
      <Footer />
    </div>
  </body>
</html>
