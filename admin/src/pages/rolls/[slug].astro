---
import AdminLayout from '../../layouts/AdminLayout.astro';
import RollEditor from '../../components/RollEditor.astro';
const { slug } = Astro.params;
if (!/^[a-z0-9-]+$/.test(slug || '')) return Astro.redirect('/rolls/');
---
<AdminLayout
  title="edit roll"
  breadcrumbs={[
    { label: '~/admin', href: '/' },
    { label: 'rolls', href: '/rolls/' },
    { label: slug || '', href: `/rolls/${slug}/` },
  ]}
>
  <RollEditor mode="edit" slug={slug} />
</AdminLayout>
<script>
  import '../../scripts/roll-editor.js';
</script>
