---
import AdminLayout from '../../layouts/AdminLayout.astro';
import RollEditor from '../../components/RollEditor.astro';
const { slug } = Astro.params;
if (!/^[a-z0-9-]+$/.test(slug || '')) return Astro.redirect('/rolls/');
---
<AdminLayout title="edit roll">
  <a class="back-link" href="/rolls/">← rolls/</a>
  <RollEditor mode="edit" slug={slug} />
</AdminLayout>
<script>
  import '../../scripts/roll-editor.js';
</script>
