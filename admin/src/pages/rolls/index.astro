---
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
---
<AdminLayout
  title="rolls"
  breadcrumbs={[
    { label: '~/admin', href: '/' },
    { label: 'rolls', href: '/rolls/' },
  ]}
>
  <PageHeader
    title="film-rolls/"
    description="Encode scans locally, then publish through a reviewed pull request."
  >
    <a slot="actions" class="admin-button" id="new-roll-link" href="/rolls/new/">new roll →</a>
  </PageHeader>

  <section class="notice-panel unsupported" id="uploader-unsupported" hidden>
    <h2>desktop uploader unavailable</h2>
    <p>This browser is missing: <span id="missing-capabilities"></span>.</p>
    <p>Use a current desktop Chromium browser for film rolls. The <a href="/travel/">travel editor remains available →</a></p>
  </section>

  <p id="roll-list-status" class="list-status" role="status">Loading committed rolls…</p>
  <ul class="roll-list" id="roll-list"></ul>
</AdminLayout>

<script>
  import '../../scripts/rolls-list.js';
</script>

<style>
  .unsupported { margin-bottom: var(--space-5); border-color: var(--color-accent-secondary); }
  .unsupported h2 { margin-bottom: var(--space-2); color: var(--color-accent-secondary); }
  .list-status { color: var(--color-text-muted); font-size: var(--font-size-sm); }
  .roll-list { list-style: none; border-top: 1px solid var(--color-border); }
  .roll-list li { border-bottom: 1px solid var(--color-border); }
  .roll-list a { display: block; padding: .7rem .5rem; color: var(--color-text-secondary); font-size: var(--font-size-sm); }
  .roll-list a::before { content: 'src/content/photos/'; color: var(--color-text-muted); }
  .roll-list a::after { content: '.md'; color: var(--color-text-muted); }
  .roll-list a:hover { color: var(--color-accent-primary); background: var(--color-bg-secondary); }
  @media (max-width: 680px) {
    .admin-button { text-align: center; }
  }
  @media (max-width: 600px) {
    .roll-list a::before { content: ''; }
  }
</style>
