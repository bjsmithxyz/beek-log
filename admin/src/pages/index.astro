---
import AdminLayout from '../layouts/AdminLayout.astro';
import AdminTree from '../components/AdminTree.astro';
import { validateNext } from '../server/auth.mjs';

const user = Astro.locals.user;
const next = validateNext(Astro.url.searchParams.get('next'));
const loginHref = `/.netlify/functions/auth-login?next=${encodeURIComponent(next)}`;
const reason = Astro.url.searchParams.get('reason');
const errors: Record<string, string> = {
  not_allowed: 'That GitHub account is not allowed to use this admin.',
  bad_state: 'The sign-in request expired. Please try again.',
  token_exchange: 'GitHub sign-in could not be completed.',
  missing_code: 'GitHub sign-in was cancelled.',
  user: 'GitHub did not return an account.',
  server: 'Sign-in failed safely on the server.',
};
const authError = Astro.url.searchParams.get('auth') === 'error'
  ? (errors[reason || ''] || 'Sign-in failed. Please try again.')
  : null;
---

{/* No page title: the breadcrumb (~/admin) and the tree's own root already name
    this page, and the tree *is* the content — the same bargain the public
    homepage makes. Sign out therefore sits in the breadcrumb row rather than
    heading a section of its own. */}
<AdminLayout>
  <Fragment slot="chrome">
    {user && (
      <div class="logout-control">
        <button class="admin-button secondary small" id="admin-logout" type="button">sign out</button>
        <p id="logout-status" role="status"></p>
      </div>
    )}
  </Fragment>

  {!user ? (
    <section class="login-panel" aria-labelledby="login-title">
      <h1 class="page-title" id="login-title">authentication required</h1>
      <p>One GitHub identity is permitted. No repository data is loaded until the server verifies it.</p>
      {authError && <p class="auth-error" role="alert">{authError}</p>}
      <a class="login-action" href={loginHref}>sign in with GitHub →</a>
    </section>
  ) : (
    <AdminTree user={user.login} />
  )}
</AdminLayout>

<style>
  .logout-control {
    display: flex;
    flex: none;
    /* Reversed so the sign-out button stays the rightmost element, keeping its
       right edge flush with the file-structure box below even when the status
       message is present. DOM order (button then status) is preserved. */
    flex-direction: row-reverse;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
  }

  .logout-control p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    text-align: right;
  }
</style>

<script>
  import '../scripts/dashboard.js';
</script>
