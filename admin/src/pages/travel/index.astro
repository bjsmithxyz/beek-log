---
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
---
<AdminLayout
  title="travel"
  breadcrumbs={[
    { label: '~/admin', href: '/' },
    { label: 'travel', href: '/travel/' },
  ]}
>
  <PageHeader
    title="travel/"
    description="Edit the committed itinerary, then review it through a pull request and public Deploy Preview."
  >
    <Fragment slot="actions">
      <button class="admin-button secondary" id="reload-travel" type="button">reload</button>
      <button class="admin-button" id="review-travel" type="button" disabled>review changes →</button>
    </Fragment>
  </PageHeader>

  <p class="editor-status" id="editor-status" role="status">Loading the itinerary from GitHub…</p>
  <section class="error-panel" id="editor-errors" role="alert" hidden>
    <h2>fix these fields</h2>
    <ul id="editor-error-list"></ul>
  </section>

  <fieldset class="travel-editor" id="travel-editor" disabled>
    <legend class="sr-only">Travel itinerary</legend>
    <section aria-labelledby="stops-title">
      <div class="section-heading sticky-heading">
        <div>
          <h2 id="stops-title">stops <span id="stop-count"></span></h2>
        </div>
        <button class="small-button" id="add-stop" type="button">+ add stop</button>
      </div>
      <div class="stop-list" id="stop-list"></div>
    </section>
  </fieldset>

  <section class="overview-panel" aria-labelledby="overview-title">
    <div class="section-heading">
      <div class="overview-heading-text">
        <button type="button" class="stop-collapse" id="overview-collapse" aria-expanded="true" aria-label="Collapse the full itinerary">▾</button>
        <div>
          <span class="section-path">trips.json/overview</span>
          <h2 id="overview-title">full itinerary</h2>
        </div>
      </div>
      <p class="overview-summary" id="travel-overview-summary"></p>
    </div>
    <div id="travel-overview-map" class="overview-map" role="region" aria-label="Map of the full itinerary"></div>
    <div class="overview-table-scroll">
      <table class="overview-table">
        <caption class="sr-only">Every stop with its exact dates and state</caption>
        <thead>
          <tr><th scope="col">arrive</th><th scope="col">depart</th><th scope="col">stop</th><th scope="col">state</th></tr>
        </thead>
        <tbody id="travel-overview-rows"></tbody>
      </table>
    </div>
  </section>

  <section class="review-panel" id="review-panel" aria-labelledby="review-title" hidden tabindex="-1">
    <span class="section-path">publication/review</span>
    <h2 id="review-title">review changes</h2>
    <p id="review-summary"></p>
    <p>This creates a branch and pull request. Production remains unchanged until you review the public Deploy Preview and choose merge.</p>
    <div class="review-actions">
      <button class="admin-button secondary" id="cancel-review" type="button">keep editing</button>
      <button class="admin-button" id="publish-travel" type="button">create pull request →</button>
    </div>
  </section>

  <section class="publication-panel" id="publication-panel" aria-labelledby="publication-title" hidden>
    <span class="section-path">publication/status</span>
    <h2 id="publication-title">publication in progress</h2>
    <p id="publication-status" role="status"></p>
    <dl class="publication-links">
      <div><dt>pull request</dt><dd><a id="publication-pr" target="_blank" rel="noopener">waiting…</a></dd></div>
      <div><dt>deploy preview</dt><dd><a id="publication-preview" target="_blank" rel="noopener">waiting for Netlify…</a></dd></div>
    </dl>
    <div class="review-actions">
      <button class="admin-button secondary" id="refresh-publication" type="button">refresh status</button>
      <button class="danger-button" id="abandon-publication" type="button">abandon</button>
      <button class="admin-button" id="merge-publication" type="button" disabled>merge to main →</button>
    </div>
  </section>
</AdminLayout>

<script>
  import '../../scripts/travel-editor.js';
</script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .review-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .editor-status { min-height: 1.6rem; color: var(--text-muted); font-size: var(--font-size-sm); }
  /* Unpublished changes read as a live, pulsing green box so they are hard to
     miss before review. */
  .editor-status.is-dirty {
    display: inline-block; margin: .1rem 0; padding: .25rem .6rem;
    color: var(--accent); border: 1px solid var(--accent);
    animation: status-pulse 1.6s ease-in-out infinite;
  }
  @keyframes status-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(51, 255, 102, .45); }
    50% { box-shadow: 0 0 0 5px rgba(51, 255, 102, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .editor-status.is-dirty { animation: none; }
  }
  .error-panel { margin: 1rem 0; padding: 1rem; border: 1px solid #ff6b6b; background: var(--panel); color: #ff9d9d; }
  .error-panel h2 { margin-bottom: .5rem; color: #ff6b6b; }
  .error-panel ul { padding-left: 1.25rem; font-size: var(--font-size-sm); }
  .travel-editor { min-width: 0; border: 0; }
  .travel-editor:disabled { opacity: .6; }
  .review-panel, .publication-panel { margin: 1rem 0 2rem; padding: 1rem; border: 1px solid var(--border); background: var(--panel); box-shadow: var(--shadow); }
  .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .section-heading h2 { color: var(--text); font-size: var(--font-size-base); }
  .section-path { color: var(--text-muted); font-size: var(--font-size-xs); }
  /* Stop cards are injected as innerHTML, so their controls need :global rules —
     Astro's scoped element selectors never reach them. One shared font size
     (sm for typed fields, xs for the muted labels/readout) keeps the card
     consistent. */
  :global(.stop-card label) { display: grid; gap: .3rem; min-width: 0; color: var(--text-muted); font-size: var(--font-size-xs); }
  :global(.stop-card input:not([type='checkbox'])), :global(.stop-card textarea) {
    width: 100%; min-width: 0; padding: .5rem .55rem; border: 1px solid var(--border); border-radius: 0;
    background: var(--bg); color: var(--text); font-size: var(--font-size-sm);
  }
  :global(.stop-card input:hover), :global(.stop-card textarea:hover) { border-color: var(--border-strong); }
  :global(.stop-card input:focus), :global(.stop-card textarea:focus) { border-color: var(--accent); }
  :global(.stop-card input::placeholder), :global(.stop-card textarea::placeholder) { color: var(--text-muted); opacity: 1; }
  :global(.stop-card textarea) { min-height: 4.2rem; resize: vertical; }
  :global(.stop-card input[type='checkbox']) { width: .95rem; height: .95rem; accent-color: var(--accent); }
  /* Match the compact button sizing used across the admin (see the sign-out button). */
  .admin-button, .small-button, .danger-button { padding: .3rem .55rem; font-size: var(--font-size-xs); }
  .small-button, .danger-button { border: 1px solid var(--border-strong); background: var(--panel-strong); color: var(--text-soft); }
  .small-button:hover { border-color: var(--accent); color: var(--accent); }
  .danger-button { color: #ff8e8e; border-color: #994444; }
  .danger-button:hover { color: var(--bg); background: #ff6b6b; border-color: #ff6b6b; }
  button:disabled { cursor: not-allowed; opacity: .45; box-shadow: none; }
  .stop-list { display: grid; gap: .75rem; }
  :global(.stop-card) { padding: 1rem; border: 1px solid var(--border); background: var(--panel); box-shadow: 2px 2px 0 var(--border); }
  :global(.stop-card:focus-within) { border-color: var(--border-strong); }
  :global(.stop-card-head) { display: flex; align-items: flex-start; justify-content: space-between; gap: .75rem; margin-bottom: .75rem; }
  :global(.stop-card-id) { display: flex; align-items: center; gap: .5rem; min-width: 0; }
  /* Collapse toggle — a chevron that rotates when its section is minimised.
     Shared by every stop card and the full-itinerary panel. */
  :global(.stop-collapse) { flex: none; width: 1.7rem; height: 1.7rem; border: 1px solid var(--border); background: var(--bg); color: var(--text-muted); cursor: pointer; line-height: 1; transition: transform var(--transition-fast); }
  :global(.stop-collapse:hover) { color: var(--accent); border-color: var(--accent); }
  :global(.stop-collapse[aria-expanded='false']) { transform: rotate(-90deg); }
  :global(.stop-card[data-collapsed] .stop-grid) { display: none; }
  :global(.stop-card[data-collapsed]) .stop-card-head { margin-bottom: 0; }
  :global(.stop-number) { color: var(--accent); font-size: var(--font-size-lg); }
  :global(.stop-name-preview) { color: var(--text-soft); font-size: var(--font-size-lg); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Actions on top, the tentative toggle tucked beneath them, both right-aligned. */
  :global(.stop-head-controls) { display: flex; flex: none; flex-direction: column; align-items: flex-end; gap: .4rem; }
  :global(.stop-actions) { display: flex; gap: .35rem; }
  :global(.stop-actions button) { width: 2rem; height: 2rem; border: 1px solid var(--border); background: var(--bg); color: var(--text-muted); }
  :global(.stop-actions button:hover) { color: var(--accent); border-color: var(--accent); }
  :global(.stop-actions .remove-stop:hover) { color: #ff6b6b; border-color: #ff6b6b; }
  /* .stop-card label sets display:grid (for the date fields); tentative needs a
     single centered row, so it must out-specify that rule. */
  :global(.stop-card .tentative-field) { display: flex; align-items: center; gap: .4rem; color: var(--text-muted); font-size: var(--font-size-xs); line-height: 1; white-space: nowrap; cursor: pointer; }
  :global(.stop-card .tentative-field input) { margin: 0; }

  /* Editable fields on the left, the read-only location readout stacked on the
     right (one line each: code / lat / lon). */
  :global(.stop-grid) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .6rem .9rem; align-items: start; }
  :global(.stop-fields) { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; min-width: 0; }
  :global(.stop-fields .dates) { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
  :global(.stop-fields .field-note) { grid-column: 1 / -1; }

  /* Resolved location: shown, never typed. Populated from place + country by the
     geocoder, refreshable with the globe button. Its own bordered box, labels
     left-aligned, values in accent green. */
  :global(.derived-field) { display: grid; justify-items: start; align-content: start; gap: .3rem; padding: .5rem .6rem; border: 1px solid var(--border); background: var(--bg); font-size: var(--font-size-xs); text-align: left; }
  :global(.derived-item) { display: flex; align-items: baseline; gap: .4rem; }
  :global(.derived-item .derived-key) { color: var(--text-muted); }
  :global(.derived-item .derived-value) { color: var(--accent); font-variant-numeric: tabular-nums; }
  :global(.refresh-geo) { justify-self: end; margin-top: .15rem; flex: none; width: 1.9rem; height: 1.9rem; border: 1px solid var(--border); background: var(--bg); color: var(--text-muted); cursor: pointer; }
  :global(.refresh-geo:hover) { color: var(--accent); border-color: var(--accent); }
  :global(.refresh-geo[aria-busy='true']) { opacity: .55; cursor: progress; }

  .overview-panel { margin: 1rem 0 2rem; padding: 1rem; border: 1px solid var(--border); background: var(--panel); box-shadow: var(--shadow); }
  .overview-heading-text { display: flex; align-items: center; gap: .5rem; }
  .overview-panel[data-collapsed] .section-heading { margin-bottom: 0; }
  .overview-panel[data-collapsed] .overview-map,
  .overview-panel[data-collapsed] .overview-table-scroll { display: none; }
  .overview-summary { color: var(--text-muted); font-size: var(--font-size-xs); font-variant-numeric: tabular-nums; }
  .overview-map { height: min(55vh, 460px); min-height: 320px; border: 1px solid var(--border-strong); background: var(--panel-strong); }
  .overview-map :global(.leaflet-popup-content-wrapper), .overview-map :global(.leaflet-popup-tip) { border-radius: 0; background: var(--panel); color: var(--text-soft); }
  .overview-map :global(.leaflet-popup-content-wrapper) { border: 1px solid var(--border-strong); box-shadow: var(--shadow); font: var(--font-size-xs) var(--font-family); }
  .overview-map :global(.leaflet-control-zoom a) { border-radius: 0; }
  .overview-map :global(.overview-muted) { color: var(--text-muted); }
  .overview-map :global(.overview-note) { margin-top: .25rem; color: var(--text-muted); font-style: italic; }

  .overview-table-scroll { margin-top: 1rem; overflow-x: auto; scrollbar-width: thin; }
  .overview-table { width: 100%; min-width: 34rem; border-collapse: collapse; font-size: var(--font-size-xs); }
  .overview-table th { padding: .5rem .6rem; color: var(--text-muted); border-bottom: 1px solid var(--border-strong); text-align: left; text-transform: uppercase; letter-spacing: .05em; }
  .overview-table :global(td) { padding: .5rem .6rem; border-bottom: 1px solid var(--border); vertical-align: top; font-variant-numeric: tabular-nums; }
  .overview-table :global(td:nth-child(-n+2)) { color: var(--text-muted); white-space: nowrap; }
  .overview-table :global(td b) { color: var(--text); font-weight: var(--font-weight-medium); }
  .overview-table :global(td span) { display: block; color: var(--text-muted); }
  .overview-table :global(.state) { display: inline-block; padding: .1rem .35rem; border: 1px solid currentColor; white-space: nowrap; }
  .overview-table :global(.state-done) { color: var(--accent); }
  .overview-table :global(.state-here-now) { color: var(--blue); }
  .overview-table :global(.state-planned), .overview-table :global(.state-tentative) { color: var(--amber); }
  .overview-table :global(.state-tentative) { border-style: dashed; }

  .review-panel { border-color: var(--amber); box-shadow: 3px 3px 0 var(--amber); }
  .review-panel h2, .publication-panel h2 { margin: .35rem 0 .75rem; }
  .publication-panel { border-color: var(--blue); box-shadow: 3px 3px 0 var(--blue); }
  .publication-links { margin: 1rem 0; border-top: 1px solid var(--border); }
  .publication-links div { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding: .65rem 0; border-bottom: 1px solid var(--border); }
  .publication-links dt { color: var(--text-muted); font-size: var(--font-size-xs); }
  .publication-links dd { min-width: 0; overflow-wrap: anywhere; font-size: var(--font-size-sm); }

  @media (max-width: 480px) {
    :global(.stop-card) { padding: .75rem; }
    :global(.stop-grid) { grid-template-columns: 1fr; }
    :global(.stop-fields) { grid-template-columns: 1fr; }
    :global(.stop-fields .dates) { grid-template-columns: 1fr; }
    :global(.derived-field) { justify-items: start; text-align: left; }
    .publication-links div { grid-template-columns: 1fr; gap: .2rem; }
    .review-actions > * { flex: 1 1 auto; }
  }
</style>
