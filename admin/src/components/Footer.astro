---
import { publicSite, tagline } from '../data/site';

interface Props {
  user?: { login?: string } | null;
}

const { user } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner admin-container">
    <div class="footer-primary">
      <div class="footer-links">
        <a class="public-home" href={publicSite}>bjsmith.xyz/</a>
        {user?.login && <span class="admin-user">{user.login}</span>}
      </div>
      <p class="footer-tagline">{tagline}</p>
    </div>

    <div class="footer-secondary">
      <button
        class="social-link theme-toggle"
        id="theme-toggle"
        aria-label="Toggle theme"
        type="button"
      >
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <p class="copyright">© {currentYear} beek</p>
    </div>
  </div>
</footer>

<script>
  import { themeColors } from '../data/site';

  // The theme is a cookie because AdminLayout resolves it server-side: the
  // admin CSP blocks inline scripts, so there is no before-paint hook to read
  // localStorage from. localStorage is still read once, to carry over a
  // preference set before this changed.
  const COOKIE = 'theme';

  function storedTheme() {
    const match = document.cookie.match(/(?:^|;\s*)theme=(light|dark)\b/);
    return match?.[1] || null;
  }

  function persist(theme: string) {
    const secure = location.protocol === 'https:' ? '; secure' : '';
    document.cookie = `${COOKIE}=${theme}; path=/; max-age=31536000; samesite=lax${secure}`;
    localStorage.setItem('theme', theme);
  }

  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'light' ? themeColors.light : themeColors.dark);
  }

  const themeToggle = document.getElementById('theme-toggle');
  const label = (theme: string) => (theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');

  // With a cookie set, the server already rendered the right theme and there is
  // nothing to correct. Without one — a first visit, or a migration — settle it
  // here and persist, so every later navigation is right before paint.
  let theme = storedTheme() || document.documentElement.getAttribute('data-theme') || 'dark';
  if (!storedTheme()) {
    theme = localStorage.getItem('theme')
      || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    persist(theme);
  }
  applyTheme(theme);
  themeToggle?.setAttribute('aria-label', label(theme));

  themeToggle?.addEventListener('click', () => {
    const nextTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    applyTheme(nextTheme);
    persist(nextTheme);
    themeToggle.setAttribute('aria-label', label(nextTheme));
  });
</script>
