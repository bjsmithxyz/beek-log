---
import { publicSite } from '../data/site';

interface Props {
  user: string;
}

const { user } = Astro.props;
---

<nav class="site-tree" aria-label="Admin index">
  <a class="tree-root" href="/" aria-current="page">~/admin</a>
  <ul>
    <li class="tree-row">
      <a class="tree-main" href={publicSite}>
        <span class="tree-prefix" aria-hidden="true">├── </span>
        <span>beek/</span>
      </a>
      <span class="tree-meta">public site</span>
    </li>
    <li class="tree-branch" data-tree-branch>
      <div class="tree-row">
        <button class="tree-main tree-toggle" type="button" aria-expanded="true" aria-controls="tree-admin" data-tree-toggle>
          <span class="tree-prefix" aria-hidden="true">└── </span>
          <span>admin/</span>
          <span class="tree-state" aria-hidden="true"></span>
        </button>
        <span class="tree-meta">{user}</span>
      </div>
      <div class="tree-collapse" id="tree-admin" data-tree-collapse data-collapsed="false">
        <div class="tree-collapse-inner">
          <ul>
            <li class="tree-branch" data-tree-branch>
              <div class="tree-row">
                <button class="tree-main tree-toggle" type="button" aria-expanded="false" aria-controls="tree-rolls" data-tree-toggle>
                  <span class="tree-prefix" aria-hidden="true">    ├── </span>
                  <span>rolls/</span>
                  <span class="tree-state" aria-hidden="true"></span>
                </button>
                <span class="tree-meta">desktop beta</span>
              </div>
              <div class="tree-collapse" id="tree-rolls" data-tree-collapse data-collapsed="true" inert>
                <div class="tree-collapse-inner">
                  <ul>
                    <li class="tree-row">
                      <a class="tree-main" href="/rolls/">
                        <span class="tree-prefix" aria-hidden="true">    │   ├── </span>
                        <span>index/</span>
                      </a>
                      <span class="tree-meta" id="tree-rolls-count">loading…</span>
                    </li>
                    <li class="tree-row" id="tree-new-roll-item">
                      <a class="tree-main" href="/rolls/new-roll/">
                        <span class="tree-prefix" aria-hidden="true">    │   └── </span>
                        <span>new-roll/</span>
                      </a>
                      <span class="tree-meta">import scans</span>
                    </li>
                  </ul>
                </div>
              </div>
            </li>
            <li class="tree-row">
              <a class="tree-main" href="/travel/">
                <span class="tree-prefix" aria-hidden="true">    └── </span>
                <span>travel/</span>
              </a>
              <span class="tree-meta" id="tree-travel-meta">loading…</span>
            </li>
          </ul>
        </div>
      </div>
    </li>
  </ul>
</nav>

<script>
  import { groupRollsByYear } from '../lib/roll-tree.mjs';

  function bindToggle(button: HTMLButtonElement) {
    if (button.dataset.treeReady === 'true') return;
    const panel = document.getElementById(button.getAttribute('aria-controls') || '');
    if (!(panel instanceof HTMLElement)) return;
    button.dataset.treeReady = 'true';
    panel.inert = button.getAttribute('aria-expanded') !== 'true';
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!expanded));
      panel.dataset.collapsed = String(expanded);
      panel.inert = expanded;
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-tree-toggle]').forEach(bindToggle);

  // Grows the static rolls/ branch with the real, currently-committed roll
  // slugs — grouped by year, same shape as the public site's own tree —
  // instead of leaving it as two hardcoded links. Slugs are already
  // constrained to [a-z0-9-]+ by the publisher, so no escaping is needed.
  function buildRollYears(rolls: { slug: string }[]): DocumentFragment {
    const fragment = document.createDocumentFragment();
    for (const { year, items } of groupRollsByYear(rolls)) {
      const controlsId = `tree-rolls-${year}`;
      const branch = document.createElement('li');
      branch.className = 'tree-branch';
      branch.dataset.treeBranch = '';
      const rows = items.map((roll, index) => {
        const prefix = index === items.length - 1 ? '    │   │   └── ' : '    │   │   ├── ';
        return `<li class="tree-row">
          <a class="tree-main" href="/rolls/${encodeURIComponent(roll.slug)}/">
            <span class="tree-prefix" aria-hidden="true">${prefix}</span>
            <span>${roll.slug}.md</span>
          </a>
        </li>`;
      }).join('');
      branch.innerHTML = `
        <div class="tree-row">
          <button class="tree-main tree-toggle" type="button" aria-expanded="false" aria-controls="${controlsId}" data-tree-toggle>
            <span class="tree-prefix" aria-hidden="true">    │   ├── </span>
            <span>${year}/</span>
            <span class="tree-state" aria-hidden="true"></span>
          </button>
          <span class="tree-meta">${items.length} ${items.length === 1 ? 'roll' : 'rolls'}</span>
        </div>
        <div class="tree-collapse" id="${controlsId}" data-tree-collapse data-collapsed="true" inert>
          <div class="tree-collapse-inner">
            <ul>${rows}</ul>
          </div>
        </div>
      `;
      fragment.append(branch);
    }
    return fragment;
  }

  async function loadRolls() {
    const count = document.getElementById('tree-rolls-count');
    const newRollItem = document.getElementById('tree-new-roll-item');
    try {
      const response = await fetch('/.netlify/functions/rolls-data', { credentials: 'same-origin' });
      const body = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(body.error || 'Could not load rolls');
      if (count) count.textContent = `${body.rolls.length} committed`;
      const years = buildRollYears(body.rolls);
      years.querySelectorAll<HTMLButtonElement>('[data-tree-toggle]').forEach(bindToggle);
      newRollItem?.before(years);
    } catch {
      if (count) count.textContent = 'offline';
    }
  }

  async function loadTravel() {
    const meta = document.getElementById('tree-travel-meta');
    try {
      const response = await fetch('/.netlify/functions/travel-data', { credentials: 'same-origin' });
      const body = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(body.error || 'Could not load travel data');
      const stops = body.trips?.stops?.length ?? 0;
      if (meta) meta.textContent = `${stops} ${stops === 1 ? 'stop' : 'stops'}`;
    } catch {
      if (meta) meta.textContent = 'offline';
    }
  }

  loadRolls();
  loadTravel();
</script>

<style>
  .site-tree {
    max-width: var(--admin-tree-max);
    padding: var(--space-4);
    overflow-x: auto;
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    box-shadow: var(--shadow-hard);
    font-size: var(--font-size-sm);
    scrollbar-width: thin;
  }

  :global(.site-tree ul) {
    list-style: none;
  }

  /* Year branches and roll rows are appended client-side (see buildRollYears
     below), so they never carry Astro's scope attribute — these rules must
     stay :global() to reach them, same as the stop-card rules in
     travel/index.astro. */
  :global(.tree-root),
  :global(.tree-row) {
    min-height: 2rem;
  }

  :global(.tree-root) {
    display: inline-flex;
    align-items: center;
    color: var(--color-accent-primary);
    font-weight: var(--font-weight-medium);
  }

  :global(.tree-row) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    min-width: 38rem;
    align-items: center;
  }

  :global(.tree-main) {
    display: flex;
    width: fit-content;
    min-width: 0;
    align-items: center;
    color: var(--color-text-primary);
    font: inherit;
    text-align: left;
  }

  :global(button.tree-main) {
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  :global(.tree-main:hover),
  :global(.tree-main:focus-visible) {
    color: var(--color-accent-primary);
  }

  :global(.tree-prefix) {
    flex: none;
    color: var(--color-text-muted);
    white-space: pre;
  }

  :global(.tree-state) {
    margin-left: var(--space-2);
    color: var(--color-text-muted);
  }

  :global(.tree-toggle[aria-expanded='true'] .tree-state::before) {
    content: '[-]';
  }

  :global(.tree-toggle[aria-expanded='false'] .tree-state::before) {
    content: '[+]';
  }

  :global(.tree-meta) {
    padding-left: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    text-align: right;
    white-space: nowrap;
  }

  :global(.tree-collapse) {
    display: grid;
    grid-template-rows: 1fr;
    opacity: 1;
    transition: grid-template-rows var(--transition-slow), opacity var(--transition-base);
  }

  :global(.tree-collapse[data-collapsed='true']) {
    grid-template-rows: 0fr;
    opacity: 0;
  }

  :global(.tree-collapse-inner) {
    min-height: 0;
    overflow: hidden;
  }
</style>
