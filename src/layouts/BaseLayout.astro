---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/400-italic.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import Breadcrumb from '../components/Breadcrumb.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { ClientRouter } from 'astro:transitions';
import {
  siteName,
  personName,
  siteDescription,
  sameAs,
  themeColors,
} from '../data/site';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title = siteName,
  description = siteDescription,
  image = '/og-image.png',
  jsonLd,
  breadcrumbs = [{ label: '~/beek', href: '/' }],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;

// Base structured data on every page; pages may add CreativeWork/ImageGallery.
const siteUrl = Astro.site?.href;
const baseGraph = [
  { '@type': 'WebSite', name: siteName, url: siteUrl },
  {
    '@type': 'Person',
    name: personName,
    url: siteUrl,
    sameAs: [...sameAs],
  },
];
const pageGraph = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const structuredData = { '@context': 'https://schema.org', '@graph': [...baseGraph, ...pageGraph] };

const themeLight = themeColors.light;
const themeDark = themeColors.dark;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content={themeDark} />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(image, Astro.site)} />
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <JsonLd schema={structuredData} />

  <ClientRouter />

  <script is:inline define:vars={{ themeLight, themeDark }}>
    const theme = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    document.documentElement.setAttribute('data-theme', theme);
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'light' ? themeLight : themeDark);
  </script>
</head>
<body>
  <a href="#main-content" class="skip-link">skip to content</a>
  <div class="page-wrapper">
    <div class="breadcrumb-row container">
      <Breadcrumb items={breadcrumbs} />
    </div>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </div>
</body>
</html>

<style>
  .page-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    position: relative;
    z-index: 1;
  }

  .breadcrumb-row {
    display: flex;
    height: 56px;
    flex: 0 0 auto;
    align-items: center;
  }

  main {
    flex: 1;
  }
</style>
