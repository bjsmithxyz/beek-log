---
// Dot-matrix world map in the site's terminal aesthetic. The land mask is a
// precomputed 240x120 grid (see scripts/generate-world-dots.mjs); exact shoot
// locations are plotted with an equirectangular projection. Pins are anchors
// that jump to the roll list below; a small script cross-highlights each pin
// with its roll row on hover and lifts the hovered pin above its neighbours.
import dots from '../data/world-dots.json';
import type { Pin } from '../data/locations';

interface Props {
  pins: Pin[];
}

const { pins } = Astro.props;

// Projection / viewBox space. Kept at 240x120 regardless of the land-mask
// resolution so pin and tooltip geometry below is unaffected.
const COLS = 240;
const ROWS = 120;

// The land-mask grid is finer than the viewBox; scale each cell into 240x120.
const grid = dots as string[];
const GRID_ROWS = grid.length;
const GRID_COLS = grid[0].length;
const cellW = COLS / GRID_COLS;
const cellH = ROWS / GRID_ROWS;
const dotR = +(cellW * 0.28).toFixed(2);

// The land mask is ~18k dots; one <circle> each made the page megabytes of
// HTML and a very heavy DOM. Instead, each row's consecutive land cells become
// one horizontal segment in a single <path>, and a dash pattern (near-zero
// dash, one-cell gap, round linecap) renders a dot at every cell centre —
// including single-cell runs, drawn as zero-length segments.
const DASH = 0.01;
const dashArray = `${DASH} ${+(cellW - DASH).toFixed(4)}`;
const dotPath = grid
  .map((row, gy) => {
    const y = +((gy + 0.5) * cellH).toFixed(1);
    let d = '';
    for (let gx = 0; gx < row.length; gx += 1) {
      if (row[gx] !== '1') continue;
      let end = gx;
      while (end + 1 < row.length && row[end + 1] === '1') end += 1;
      d += `M${+((gx + 0.5) * cellW).toFixed(1)} ${y}H${+((end + 0.5) * cellW).toFixed(1)}`;
      gx = end;
    }
    return d;
  })
  .join('');

const project = (lat: number, lng: number) => ({
  x: +(((lng + 180) / 360) * COLS).toFixed(1),
  y: +(((90 - lat) / 180) * ROWS).toFixed(1),
});

// Tooltip geometry, in viewBox units. Monospace advance ≈ 0.6em. Every box gets
// the same width — the widest line across all pins — so tooltips are uniform;
// the title sits on top with each sub-region stacked on its own line below.
// Sizes are in viewBox units, so on-screen text scales with map width. The map
// is ~2.6x narrower on mobile than desktop, so these are tuned up for mobile
// legibility; desktop tooltips render larger but they're transient hover popups.
const TT = {
  fontSize: 5.2, // title line: "Label — N frames"
  subSize: 4, // sub-region lines
  padX: 2.3, // left/right inner padding
  padTop: 2.1,
  padBottom: 2,
  titleGap: 1.9, // title baseline to first sub-region
  lineH: 4.6, // per sub-region line height
};

const titleFor = (p: Pin) => `${p.label} — ${p.count} ${p.count === 1 ? 'frame' : 'frames'}`;
const radiusFor = (p: Pin) => +(0.525 + Math.min(0.575, Math.log2(p.count + 1) * 0.16)).toFixed(2);

const tooltipWidth =
  Math.max(
    ...pins.map((p) =>
      Math.max(
        titleFor(p).length * TT.fontSize * 0.6,
        // sub-region lines carry a "· " bullet prefix (+2 chars)
        ...p.members.map((m) => (m.length + 2) * TT.subSize * 0.6)
      )
    )
  ) +
  TT.padX * 2;
---

<div class="map-shell">
  <div class="map-toolbar">
    <span class="map-key"><i aria-hidden="true"></i>{pins.length} {pins.length === 1 ? 'location' : 'locations'}</span>
    <span class="map-help">scroll or ± to zoom · drag to pan · click a pin to jump</span>
  </div>

  <div class="map-viewport">
  <svg
    viewBox="0 0 240 120"
    class="world-map"
    role="img"
    aria-label={`Map of shoot locations: ${pins.map((p) => p.label).join(', ')}`}
  >
  <defs>
    <filter id="pin-halo-blur" x="-100%" y="-100%" width="300%" height="300%">
      <feGaussianBlur stdDeviation="1.8" />
    </filter>
  </defs>
  <path class="dots" d={dotPath} stroke-width={dotR * 2} stroke-dasharray={dashArray} />

  {pins.map((p) => {
    const { x, y } = project(p.lat, p.lng);
    const title = titleFor(p);
    const width = tooltipWidth;
    const rectH =
      TT.padTop +
      TT.fontSize +
      (p.members.length ? TT.titleGap + TT.lineH * p.members.length : 0) +
      TT.padBottom;
    const rectX = Math.min(Math.max(x - width / 2, 1), COLS - width - 1);
    const rectY = Math.max(1, y - 3 - rectH);
    const cx = rectX + width / 2;
    return (
      <a href={`#roll-${p.slug}`} class="pin-link" aria-label={`Open rolls from ${title}`} data-slugs={p.slugs.join(' ')}>
        <title>{title}</title>
        <circle cx={x} cy={y} r={radiusFor(p)} class="pin-hit" />
        <circle cx={x} cy={y} r={radiusFor(p) + 2.2} class="pin-halo" />
        <circle cx={x} cy={y} r={radiusFor(p)} class="pin" />
        <g class="tooltip" aria-hidden="true" data-cx={cx} data-y={rectY} data-h={rectH} data-w={width}>
          <rect x={rectX} y={rectY} width={width} height={rectH} rx="0.8" class="tooltip-box" />
          <text
            x={rectX + TT.padX}
            y={rectY + TT.padTop + TT.fontSize / 2}
            font-size={TT.fontSize}
            text-anchor="start"
            dominant-baseline="central"
            class="tooltip-text"
          >{title}</text>
          {p.members.map((m, i) => (
            <text
              x={rectX + TT.padX}
              y={rectY + TT.padTop + TT.fontSize + TT.titleGap + TT.lineH * i + TT.lineH / 2}
              font-size={TT.subSize}
              text-anchor="start"
              dominant-baseline="central"
              class="tooltip-sub"
            >{`· ${m}`}</text>
          ))}
        </g>
      </a>
    );
  })}
  </svg>

    <div class="map-zoom" role="group" aria-label="Zoom map">
      <button type="button" class="map-zoom-btn" data-zoom="in" aria-label="Zoom in">+</button>
      <button type="button" class="map-zoom-btn" data-zoom="out" aria-label="Zoom out">−</button>
      <button type="button" class="map-zoom-btn" data-zoom="reset" aria-label="Reset zoom">⤢</button>
    </div>
  </div>

  <div class="map-footnote">
    <span><b>●</b> hover a pin for roll details</span>
  </div>
</div>

<script>
  function setupMapHover() {
    const svg = document.querySelector('.world-map');
    if (!(svg instanceof SVGElement) || svg.dataset.mapReady === 'true') return;
    svg.dataset.mapReady = 'true';

    // bring a pin to the end of the SVG so its tooltip paints above neighbours
    const lift = (pin: Element) => svg.appendChild(pin);

    const setPin = (pin: Element, on: boolean) => {
      pin.classList.toggle('is-active', on);
      if (on) lift(pin);
    };

    // A single roll can light up several nearby pins at once (e.g. a trip across
    // Thailand + Vietnam). Their tooltips are each centred on their own pin and
    // would overlap, so nudge colliding boxes downward into a clean stack.
    const num = (el: Element, k: string) => +((el as HTMLElement).dataset[k] || 0);
    const relayoutTooltips = () => {
      const all = svg.querySelectorAll<SVGGElement>('.tooltip');
      all.forEach((t) => t.removeAttribute('transform'));
      const boxes = [...svg.querySelectorAll<SVGGElement>('.pin-link.is-active .tooltip')]
        .map((el) => ({ el, cx: num(el, 'cx'), y: num(el, 'y'), h: num(el, 'h'), w: num(el, 'w') }))
        .sort((a, b) => a.y - b.y); // topmost first; later boxes cascade below
      const gap = 1;
      const placed: typeof boxes = [];
      for (const b of boxes) {
        let y = b.y;
        for (const p of placed) {
          const overlapX = Math.abs(b.cx - p.cx) < (b.w + p.w) / 2;
          if (overlapX && y < p.y + p.h + gap && y + b.h > p.y) y = p.y + p.h + gap;
        }
        if (y !== b.y) b.el.setAttribute('transform', `translate(0 ${(y - b.y).toFixed(2)})`);
        placed.push({ ...b, y });
      }
    };

    // A pin can stand for several rolls (same country grouped into one pin), and
    // a roll can span several pins (photos in different countries). Cross-
    // highlight every matching counterpart, not just one.
    const rowsForPin = (pin: Element) =>
      ((pin as HTMLElement).dataset.slugs || '').split(' ').filter(Boolean)
        .map((s) => document.getElementById(`roll-${s}`))
        .filter((r): r is HTMLElement => !!r);

    // Persistent highlight left on the target rows after a pin is clicked, so
    // the jumped-to roll stays lit until the visitor clicks it or clicks away.
    let jumped: HTMLElement[] = [];
    const clearJumped = () => {
      jumped.forEach((r) => r.classList.remove('is-pin-jumped'));
      jumped = [];
      document.removeEventListener('pointerdown', onAwayClick, true);
    };
    const onAwayClick = () => clearJumped();
    const markJumped = (rows: HTMLElement[]) => {
      clearJumped();
      jumped = rows;
      rows.forEach((r) => r.classList.add('is-pin-jumped'));
      // arm the dismiss listener after this click settles so it doesn't clear itself
      setTimeout(() => document.addEventListener('pointerdown', onAwayClick, true), 0);
    };

    svg.querySelectorAll<HTMLElement>('.pin-link').forEach((pin) => {
      const rows = rowsForPin(pin);
      const on = () => { setPin(pin, true); rows.forEach((r) => r.classList.add('is-pin-active')); relayoutTooltips(); };
      const off = () => { setPin(pin, false); rows.forEach((r) => r.classList.remove('is-pin-active')); relayoutTooltips(); };
      pin.addEventListener('mouseenter', on);
      pin.addEventListener('mouseleave', off);
      pin.addEventListener('focus', on);
      pin.addEventListener('blur', off);
      pin.addEventListener('click', () => { if (rows.length) markJumped(rows); });
    });

    document.querySelectorAll<HTMLElement>('.roll-row[data-slug]').forEach((row) => {
      const slug = row.dataset.slug;
      // ~= matches the slug as one whitespace-separated token within data-slugs
      const pins = svg.querySelectorAll(`.pin-link[data-slugs~="${slug}"]`);
      row.addEventListener('mouseenter', () => { pins.forEach((p) => setPin(p, true)); relayoutTooltips(); });
      row.addEventListener('mouseleave', () => { pins.forEach((p) => setPin(p, false)); relayoutTooltips(); });
    });

    // --- Pan + zoom -------------------------------------------------------
    // Some shoot locations sit almost on top of each other; let visitors zoom
    // and pan by driving the SVG viewBox (wheel / drag / pinch / buttons).
    const FULL = { x: 0, y: 0, w: 240, h: 120 };
    const MIN_W = 30; // deepest zoom (240 / 30 = 8x)
    const vb = { ...FULL };
    const apply = () => {
      svg.setAttribute('viewBox', `${+vb.x.toFixed(2)} ${+vb.y.toFixed(2)} ${+vb.w.toFixed(2)} ${+vb.h.toFixed(2)}`);
      const zoomed = vb.w < FULL.w - 0.01;
      svg.classList.toggle('is-zoomed', zoomed);
      // only swallow touch gestures once zoomed, so the page still scrolls past
      // the map at its default extent
      (svg as SVGElement & { style: CSSStyleDeclaration }).style.touchAction = zoomed ? 'none' : '';
    };
    const clampPan = () => {
      vb.x = Math.min(FULL.w - vb.w, Math.max(0, vb.x));
      vb.y = Math.min(FULL.h - vb.h, Math.max(0, vb.y));
    };
    const toVB = (clientX: number, clientY: number) => {
      const rect = svg.getBoundingClientRect();
      return {
        x: vb.x + ((clientX - rect.left) / rect.width) * vb.w,
        y: vb.y + ((clientY - rect.top) / rect.height) * vb.h,
      };
    };
    const zoomAt = (factor: number, fx: number, fy: number) => {
      const w = Math.min(FULL.w, Math.max(MIN_W, vb.w * factor));
      const h = w / 2;
      vb.x = fx - (fx - vb.x) * (w / vb.w);
      vb.y = fy - (fy - vb.y) * (h / vb.h);
      vb.w = w;
      vb.h = h;
      clampPan();
      apply();
    };
    const zoomCenter = (factor: number) => zoomAt(factor, vb.x + vb.w / 2, vb.y + vb.h / 2);

    svg.addEventListener('wheel', (event) => {
      event.preventDefault();
      const { x, y } = toVB(event.clientX, event.clientY);
      zoomAt(event.deltaY > 0 ? 1.2 : 1 / 1.2, x, y);
    }, { passive: false });

    document.querySelectorAll<HTMLButtonElement>('.map-zoom-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const kind = btn.dataset.zoom;
        if (kind === 'in') zoomCenter(1 / 1.5);
        else if (kind === 'out') zoomCenter(1.5);
        else { Object.assign(vb, FULL); apply(); }
      });
    });

    // Drag to pan; pinch (two pointers) to zoom. A pin click that turns into a
    // drag is suppressed via the `moved` flag + a capture-phase click guard.
    const pointers = new Map<number, { x: number; y: number }>();
    let start: { x: number; y: number; vbx: number; vby: number } | null = null;
    let pinchDist = 0;
    let moved = false;
    svg.addEventListener('pointerdown', (event) => {
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      moved = false;
      if (pointers.size === 1) {
        start = { x: event.clientX, y: event.clientY, vbx: vb.x, vby: vb.y };
      } else if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        pinchDist = Math.hypot(a.x - b.x, a.y - b.y);
      }
      svg.setPointerCapture(event.pointerId);
    });
    svg.addEventListener('pointermove', (event) => {
      if (!pointers.has(event.pointerId)) return;
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      const rect = svg.getBoundingClientRect();
      if (pointers.size >= 2) {
        const [a, b] = [...pointers.values()];
        const dist = Math.hypot(a.x - b.x, a.y - b.y);
        if (pinchDist > 0 && dist > 0) {
          const mid = toVB((a.x + b.x) / 2, (a.y + b.y) / 2);
          zoomAt(pinchDist / dist, mid.x, mid.y);
        }
        pinchDist = dist;
        moved = true;
      } else if (start && vb.w < FULL.w) {
        const dx = ((event.clientX - start.x) / rect.width) * vb.w;
        const dy = ((event.clientY - start.y) / rect.height) * vb.h;
        if (Math.abs(event.clientX - start.x) > 3 || Math.abs(event.clientY - start.y) > 3) moved = true;
        vb.x = start.vbx - dx;
        vb.y = start.vby - dy;
        clampPan();
        apply();
      }
    });
    const endPointer = (event: PointerEvent) => {
      pointers.delete(event.pointerId);
      if (pointers.size < 2) pinchDist = 0;
      if (pointers.size === 0) start = null;
      try { svg.releasePointerCapture(event.pointerId); } catch { /* not captured */ }
    };
    svg.addEventListener('pointerup', endPointer);
    svg.addEventListener('pointercancel', endPointer);
    // suppress the pin's navigation + highlight when the gesture was a drag
    svg.addEventListener('click', (event) => {
      if (!moved) return;
      event.preventDefault();
      event.stopPropagation();
      moved = false;
    }, true);
  }

  setupMapHover();
  document.addEventListener('astro:page-load', setupMapHover);
</script>

<style>
  .map-shell {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
  }

  .map-toolbar,
  .map-footnote {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  .map-toolbar {
    min-height: 38px;
    background: var(--color-bg-tertiary);
    border-bottom: 1px solid var(--color-border);
  }

  .map-key {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-primary);
  }

  .map-key i {
    display: block;
    width: 7px;
    height: 7px;
    background: var(--color-accent-primary);
    border-radius: 50%;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent-primary) 20%, transparent);
  }

  .map-help {
    color: var(--color-text-muted);
    text-align: right;
  }

  .map-viewport {
    position: relative;
  }

  .world-map {
    width: 100%;
    height: auto;
    display: block;
    background: var(--color-bg-secondary);
    padding: var(--space-3);
    touch-action: pan-y;
  }

  .world-map.is-zoomed {
    cursor: grab;
  }

  .world-map.is-zoomed:active {
    cursor: grabbing;
  }

  .map-zoom {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .map-zoom-btn {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: var(--color-text-primary);
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border-strong);
    font: inherit;
    font-size: var(--font-size-base);
    line-height: 1;
    cursor: pointer;
    transition: color var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast);
  }

  .map-zoom-btn:hover {
    color: var(--color-bg-primary);
    background: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
  }

  .map-footnote {
    border-top: 1px solid var(--color-border);
  }

  .map-footnote b {
    color: var(--color-accent-primary);
  }

  .dots {
    fill: none;
    stroke: var(--color-border-strong);
    stroke-linecap: round;
    opacity: 0.82;
  }

  .pin-hit {
    fill: transparent;
    pointer-events: all;
  }

  .pin {
    fill: var(--color-accent-primary);
    stroke: var(--color-bg-primary);
    stroke-width: 0.45;
    transition: filter 0.12s ease, transform 0.12s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .pin-halo {
    fill: var(--color-accent-primary);
    opacity: 0;
    pointer-events: none;
    filter: url(#pin-halo-blur);
    transition: opacity 0.12s ease, transform 0.12s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .pin-link {
    cursor: pointer;
  }

  .pin-link:hover .pin-halo,
  .pin-link:focus .pin-halo,
  .pin-link.is-active .pin-halo {
    opacity: 0.36;
    transform: scale(1.3);
  }

  .pin-link:hover .pin,
  .pin-link:focus .pin,
  .pin-link.is-active .pin {
    filter: brightness(0.82);
    transform: scale(1.18);
  }

  .tooltip {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s ease;
  }

  .pin-link:hover .tooltip,
  .pin-link:focus .tooltip,
  .pin-link.is-active .tooltip {
    opacity: 1;
  }

  .tooltip-box {
    fill: var(--color-bg-primary);
    stroke: var(--color-accent-secondary);
    stroke-width: 0.45;
    filter: drop-shadow(1px 1px 0 var(--color-border-strong));
  }

  .tooltip-text,
  .tooltip-sub {
    font-family: var(--font-family);
  }

  .tooltip-text {
    fill: var(--color-text-primary);
    font-weight: 500;
  }

  .tooltip-sub {
    fill: var(--color-text-secondary);
  }

  @media (max-width: 520px) {
    .map-toolbar,
    .map-footnote {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-1);
    }

    .map-help {
      text-align: left;
    }

    .world-map {
      padding: var(--space-2);
    }
  }
</style>
