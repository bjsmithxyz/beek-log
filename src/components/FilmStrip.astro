---
// One strip of a contact sheet: sprocket holes, film-edge markings and up to
// ~6 frames. The film base stays near-black in both themes (it's an object,
// not UI); sprocket holes show the page background, as if punched through.
import { Image, getImage } from 'astro:assets';
import { MAX_EDGE } from '@beek/shared/image-constants';

interface Photo {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  locName: string;
}

interface Props {
  photos: Photo[];
  stockName: string;
  stockType: 'color' | 'bw';
  startFrame?: number;
  stripNumber?: number;
  stripTotal?: number;
  shortDate: string;
}

const {
  photos,
  stockName,
  stockType,
  startFrame = 1,
  stripNumber = 1,
  stripTotal = 1,
  shortDate,
} = Astro.props;

// colour negative edge print is orange; B&W rebate text is grey
const edgeColor = stockType === 'bw' ? 'var(--color-text-secondary)' : 'var(--color-accent-secondary)';

const fullImages = await Promise.all(
  photos.map((p) => getImage({ src: p.src, width: MAX_EDGE }))
);
---

<section
  class="film-strip"
  style={`--edge-color: ${edgeColor}`}
  aria-label={`Frames ${startFrame} through ${startFrame + photos.length - 1}`}
>
  <div class="sprockets" aria-hidden="true"></div>
  <div class="edge-markings" aria-hidden="true">
    <span class="strip-index">{String(stripNumber).padStart(2, '0')} / {String(stripTotal).padStart(2, '0')}</span>
    <span class="stock-name">{stockName.toUpperCase()}</span>
    <span class="arrows">▸▸</span>
    <span class="frame-range">{startFrame}–{startFrame + photos.length - 1}</span>
  </div>
  <div class="frames" tabindex="0" aria-label="Frames; scroll horizontally to see all exposures">
    {photos.map((p, i) => (
      <figure class="frame">
        <Image
          src={p.src}
          alt={p.alt}
          width={400}
          height={267}
          class="frame-img"
          loading="lazy"
          data-lightbox
          data-lightbox-id={`frame-${startFrame + i}`}
          data-full={fullImages[i].src}
          data-caption={p.caption ?? p.alt}
          data-meta={`${stockName.toUpperCase()} · ${shortDate} · ${photos[i].locName.toUpperCase()}`}
        />
        <figcaption class="frame-no">
          <span>{startFrame + i}</span>
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="sprockets" aria-hidden="true"></div>
</section>

<style>
  .film-strip {
    background: #161412;
    border: 1px solid var(--color-border);
    padding: 3px 0;
    margin-bottom: var(--space-4);
  }

  .film-strip:last-child {
    margin-bottom: 0;
  }

  .sprockets {
    height: 12px;
    margin: 3px 10px;
    background-image: repeating-linear-gradient(
      to right,
      transparent 0 7px,
      var(--color-bg-primary) 7px 17px,
      transparent 17px 24px
    );
  }

  .edge-markings {
    display: flex;
    gap: var(--space-4);
    padding: 1px 14px 3px;
    font-size: var(--font-size-xs);
    letter-spacing: 0.18em;
    color: var(--edge-color);
    user-select: none;
    white-space: nowrap;
    overflow: hidden;
  }

  .strip-index {
    color: var(--color-text-secondary);
    letter-spacing: 0.1em;
  }

  .frame-range {
    margin-left: auto;
  }

  .frames {
    display: flex;
    gap: 6px;
    padding: 2px 10px 6px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    /* Firefox: thin, square, themed */
    scrollbar-width: thin;
    scrollbar-color: var(--color-border-strong) transparent;
  }

  /* WebKit: square brutalist scrollbar matching the site */
  .frames::-webkit-scrollbar {
    height: 8px;
  }

  .frames::-webkit-scrollbar-track {
    background: transparent;
  }

  .frames::-webkit-scrollbar-thumb {
    background: var(--color-border-strong);
    border: 1px solid #000;
  }

  .frames::-webkit-scrollbar-thumb:hover {
    background: var(--edge-color);
  }

  .frame {
    margin: 0;
    flex: 0 0 clamp(130px, 16vw, 180px);
    scroll-snap-align: start;
  }

  .frame-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    cursor: pointer;
    border: 1px solid #000;
    transition: transform var(--transition-fast), filter var(--transition-fast), border-color var(--transition-fast);
  }

  .frame-img:hover {
    border-color: var(--edge-color);
    filter: saturate(1.15) contrast(1.04);
    transform: translateY(-2px);
  }

  .frames:focus-visible {
    outline: 1px solid var(--color-accent-primary);
    outline-offset: -1px;
  }

  .frame-no {
    display: flex;
    justify-content: space-between;
    font-size: var(--font-size-xs);
    color: var(--edge-color);
    letter-spacing: 0.1em;
    padding: 2px 2px 0;
    user-select: none;
  }
</style>
