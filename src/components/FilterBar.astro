---
interface Props {
  options: string[];
  /** CSS selector for filterable rows (e.g. `.work-row[data-category]`) */
  rowSelector: string;
  /** Row attribute to match against `data-filter` (e.g. `data-category`) */
  filterAttr: string;
}

const { options, rowSelector, filterAttr } = Astro.props;
---

{options.length > 0 && (
  <div
    class="filters"
    role="group"
    aria-label="Filter entries"
    data-dir-filters
    data-row-selector={rowSelector}
    data-filter-attr={filterAttr}
  >
    <button type="button" class="filter-btn active" data-filter="all" aria-pressed="true">[all]</button>
    {options.map((opt) => (
      <button type="button" class="filter-btn" data-filter={opt} aria-pressed="false">[{opt}]</button>
    ))}
  </div>
)}

<script>
  function setupDirFilters() {
    document.querySelectorAll<HTMLElement>('[data-dir-filters]').forEach((el) => {
      const rowSelector = el.dataset.rowSelector;
      const filterAttr = el.dataset.filterAttr;
      if (!rowSelector || !filterAttr) return;
      if (el.dataset.filtersReady === 'true') return;
      el.dataset.filtersReady = 'true';

      const filterBtns = el.querySelectorAll('.filter-btn');
      const rows = document.querySelectorAll(rowSelector);

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => {
            b.classList.remove('active');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');

          const filter = btn.getAttribute('data-filter');
          rows.forEach((row) => {
            const value = row.getAttribute(filterAttr);
            const isMatch = filter === 'all' || value === filter;
            const element = row as HTMLElement;
            if (isMatch) element.style.removeProperty('display');
            else element.style.display = 'none';
          });
        });
      });
    });
  }

  // Bind immediately, then again after each ClientRouter swap. Waiting for
  // astro:page-load alone left the buttons dead on a cold load: the router
  // raises that event from the window `load` event, which does not fire until
  // every subresource has finished, so the page looked ready long before the
  // filters answered a click. The dataset guard keeps the second call a no-op.
  setupDirFilters();
  document.addEventListener('astro:page-load', setupDirFilters);
</script>
