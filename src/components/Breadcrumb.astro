---
interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <div class="breadcrumb-path">
    <span class="breadcrumb-backdrop" aria-hidden="true"></span>
    <ol>
      {items.map((item, index) => (
        <li>
          {index > 0 && <span class="breadcrumb-separator" aria-hidden="true">/</span>}
          <a href={item.href} aria-current={index === items.length - 1 ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
  .breadcrumb {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    flex: 1;
    margin: 0;
    overflow-x: auto;
    padding: 2px 0;
    scrollbar-width: thin;
  }

  .breadcrumb-path {
    position: relative;
    width: max-content;
    min-width: 0;
  }

  .breadcrumb ol {
    position: relative;
    z-index: 1;
    display: flex;
    width: max-content;
    min-width: 0;
    list-style: none;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-base);
    white-space: nowrap;
  }

  .breadcrumb-backdrop {
    position: absolute;
    display: block;
    inset: -0.65rem -1.25rem;
    z-index: 0;
    pointer-events: none;
    background: color-mix(in srgb, var(--color-bg-primary) 32%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 999px;
    mask-image: radial-gradient(ellipse at center, #000 52%, rgb(0 0 0 / 82%) 68%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 52%, rgb(0 0 0 / 82%) 68%, transparent 100%);
  }

  .breadcrumb li {
    display: flex;
    align-items: center;
  }

  .breadcrumb a,
  .breadcrumb-separator {
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    text-decoration: none;
  }

  .breadcrumb a:hover,
  .breadcrumb a:focus-visible {
    color: var(--color-accent-primary);
  }

  .breadcrumb a[aria-current='page'] {
    color: var(--color-text-secondary);
  }

  .breadcrumb a[aria-current='page']:hover,
  .breadcrumb a[aria-current='page']:focus-visible {
    color: var(--color-accent-primary);
  }
</style>
