---
// Full-screen lightbox shared by work galleries and photo contact sheets.
// Any <img data-lightbox> on the page participates. Optional data attributes:
//   data-full    — larger image URL to show instead of the thumbnail src
//   data-caption — caption line (falls back to alt text before " - ")
//   data-meta    — small metadata line under the caption (film stock, frame, …)
---

<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Image preview" aria-hidden="true" inert>
  <button class="lightbox-close" aria-label="Close lightbox" tabindex="-1">&times;</button>

  <div class="lightbox-content">
    <img id="lightbox-img" src="" alt="" />
    <div class="lightbox-loading" aria-hidden="true">loading…</div>
    <div class="lightbox-bar">
      <button class="lightbox-nav lightbox-prev" aria-label="Previous image" tabindex="-1">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        prev
      </button>
      <p id="lightbox-meta"></p>
      <button class="lightbox-nav lightbox-next" aria-label="Next image" tabindex="-1">
        next
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  // Current page's lightbox controller; document/window listeners delegate to
  // it. Each setup aborts the previous one so ClientRouter re-entry does not
  // stack handlers on chrome that survives a swap.
  let lb: {
    ids: string[];
    isActive: () => boolean;
    show: (i: number) => void;
    hide: () => void;
    navigate: (dir: number) => void;
    requestClose: () => void;
  } | null = null;
  let setupAbort: AbortController | null = null;

  function onKeydown(e: KeyboardEvent) {
    if (!lb || !lb.isActive()) return;
    if (e.key === 'Escape') lb.requestClose();
    if (e.key === 'ArrowLeft') lb.navigate(-1);
    if (e.key === 'ArrowRight') lb.navigate(1);
    if (e.key === 'Tab') {
      const controls = [...document.querySelectorAll<HTMLElement>('#lightbox button')];
      const first = controls[0];
      const last = controls.at(-1);
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last?.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first?.focus();
      }
    }
  }

  function onPopstate() {
    if (!lb) return;
    const idx = lb.ids.indexOf(location.hash.slice(1));
    if (idx >= 0) lb.show(idx);
    else if (lb.isActive()) lb.hide();
  }

  function setupLightbox() {
    setupAbort?.abort();
    setupAbort = new AbortController();
    const { signal } = setupAbort;

    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxMeta = document.getElementById('lightbox-meta');
    const closeBtn = document.querySelector('.lightbox-close');
    const prevBtn = document.querySelector('.lightbox-prev');
    const nextBtn = document.querySelector('.lightbox-next');
    const galleryItems = document.querySelectorAll('[data-lightbox]') as NodeListOf<HTMLImageElement>;

    if (!lightbox || !lightboxImg || !lightboxMeta || !closeBtn || !prevBtn || !nextBtn) {
      lb = null;
      return;
    }

    let currentIndex = 0;
    let opener: HTMLElement | null = null;
    // pending src-clear from hide(); cancelled on render so a quick reopen
    // doesn't get its freshly-set image blanked
    let clearSrcTimer: ReturnType<typeof setTimeout> | undefined;
    const ids = Array.from(galleryItems).map((el, i) => el.dataset.lightboxId || `img-${i}`);
    const isActive = () => lightbox.classList.contains('active');

    const render = (index: number) => {
      clearTimeout(clearSrcTimer);
      currentIndex = index;
      const item = galleryItems[currentIndex];
      if (!item) return;

      lightbox.classList.add('is-loading');
      lightboxImg.onload = () => lightbox.classList.remove('is-loading');
      lightboxImg.onerror = () => lightbox.classList.remove('is-loading');
      lightboxImg.src = item.dataset.full || item.src;
      // cached/same-source images may not fire onload — clear immediately
      if (lightboxImg.complete && lightboxImg.naturalWidth) lightbox.classList.remove('is-loading');
      lightboxImg.alt = item.alt;
      lightboxMeta.textContent = item.dataset.meta ?? '';

      // Warm the next and previous full-size frames while the current exposure is read.
      [-1, 1].forEach((direction) => {
        const adjacent = galleryItems[(currentIndex + direction + galleryItems.length) % galleryItems.length];
        if (adjacent) {
          const preload = new window.Image();
          preload.src = adjacent.dataset.full || adjacent.src;
        }
      });
    };

    const show = (index: number) => {
      render(index);
      lightbox.inert = false;
      lightbox.querySelectorAll<HTMLElement>('button').forEach((item) => item.removeAttribute('tabindex'));
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      (closeBtn as HTMLElement).focus();
    };

    const hide = () => {
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      lightbox.inert = true;
      lightbox.querySelectorAll<HTMLElement>('button').forEach((item) => { item.tabIndex = -1; });
      document.body.style.overflow = '';
      opener?.focus();
      clearSrcTimer = setTimeout(() => {
        lightboxImg.src = '';
      }, 300);
    };

    // Open via a pushed history entry so the URL carries the frame id and the
    // browser Back button closes the lightbox.
    const openAt = (index: number, trigger: HTMLElement) => {
      opener = trigger;
      history.pushState({ lb: true }, '', '#' + ids[index]);
      show(index);
    };

    const navigate = (direction: number) => {
      let next = currentIndex + direction;
      if (next < 0) next = galleryItems.length - 1;
      if (next >= galleryItems.length) next = 0;
      history.replaceState({ lb: true }, '', '#' + ids[next]);
      render(next);
    };

    const requestClose = () => {
      // unwind our pushed entry if present, else just drop the hash
      if (history.state && (history.state as { lb?: boolean }).lb) {
        history.back();
      } else {
        history.replaceState(null, '', location.pathname + location.search);
        hide();
      }
    };

    galleryItems.forEach((item, index) => {
      item.tabIndex = 0;
      item.setAttribute('role', 'button');
      item.setAttribute('aria-haspopup', 'dialog');
      item.addEventListener('click', () => openAt(index, item), { signal });
      item.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        openAt(index, item);
      }, { signal });
    });

    closeBtn.addEventListener('click', requestClose, { signal });
    prevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      navigate(-1);
    }, { signal });
    nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      navigate(1);
    }, { signal });

    let touchStartX = 0;
    lightbox.addEventListener('touchstart', (event) => {
      touchStartX = event.changedTouches[0]?.screenX ?? 0;
    }, { signal, passive: true });
    lightbox.addEventListener('touchend', (event) => {
      const delta = (event.changedTouches[0]?.screenX ?? 0) - touchStartX;
      if (Math.abs(delta) > 50) navigate(delta < 0 ? 1 : -1);
    }, { signal, passive: true });

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target === document.querySelector('.lightbox-content')) {
        requestClose();
      }
    }, { signal });

    lb = { ids, isActive, show, hide, navigate, requestClose };

    document.addEventListener('keydown', onKeydown, { signal });
    window.addEventListener('popstate', onPopstate, { signal });

    // deep link: open the frame named in the URL hash on initial load
    const initialIdx = ids.indexOf(location.hash.slice(1));
    if (initialIdx >= 0) show(initialIdx);
  }

  // Bind as soon as this module runs. Waiting for astro:page-load alone left
  // frames dead on cold loads (that event waits on window `load`, i.e. every
  // thumbnail) and on ClientRouter arrivals (the roll page's script can load
  // after page-load already fired). Re-run on page-load for roll→roll swaps.
  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(12px);
    touch-action: pan-y;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s ease;
    padding: var(--space-8);
  }

  .lightbox.active {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-content {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .lightbox.active .lightbox-content {
    transform: scale(1);
  }

  .lightbox-content img {
    max-width: 100%;
    max-height: calc(90vh - 80px);
    object-fit: contain;
    border: 1px solid var(--color-border);
  }

  .lightbox-loading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-family);
    font-size: var(--font-size-sm);
    letter-spacing: 0.18em;
    color: var(--color-accent-primary);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    pointer-events: none;
    display: none;
    animation: lightbox-blink 1s steps(2, start) infinite;
  }

  .lightbox.is-loading .lightbox-loading {
    display: block;
  }

  .lightbox.is-loading #lightbox-img {
    opacity: 0.3;
  }

  @keyframes lightbox-blink {
    50% { opacity: 0.3; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox-loading { animation: none; }
  }

  .lightbox-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: 100%;
  }

  .lightbox-content #lightbox-meta {
    flex: 1 1 auto;
    margin: 0;
    color: #cccccc;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.15em;
    text-align: center;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  }

  .lightbox-content #lightbox-meta:empty {
    display: none;
  }

  .lightbox-close {
    position: absolute;
    top: var(--space-8);
    right: var(--space-8);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    cursor: pointer;
    z-index: 10001;
    transition: all var(--transition-fast);
  }

  .lightbox-close:hover {
    background: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
    color: var(--color-bg-primary);
  }

  .lightbox-nav {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 40px;
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    font: inherit;
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .lightbox-nav:hover {
    background: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
    color: var(--color-bg-primary);
  }

  .lightbox-nav svg {
    display: block;
  }

  @media (max-width: 768px) {
    .lightbox {
      padding: var(--space-4);
    }
    .lightbox-close {
      top: var(--space-4);
      right: var(--space-4);
      width: 40px;
      height: 40px;
      font-size: 1.5rem;
    }
    .lightbox-bar {
      gap: var(--space-2);
    }
    .lightbox-nav {
      background: rgba(0, 0, 0, 0.5);
      border-color: rgba(255, 255, 255, 0.2);
    }
  }
</style>
