---
import { socialLinks, tagline } from '../data/site';

const currentYear = new Date().getFullYear();
// Instagram brand glyph: Simple Icons (CC0), https://simpleicons.org/?q=instagram
---

<footer class="footer">
  <div class="footer-inner container">
    <div class="footer-primary">
      <nav class="social-links" aria-label="Social links">
        {socialLinks.map(link => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label={link.label}
          >
            {link.label === 'github' ? (
              <svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z"></path>
              </svg>
            ) : (
              <svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.585-.07 4.85-.148 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.069-4.849.069-3.26 0-3.668-.012-4.95-.073-3.232-.154-4.74-1.694-4.89-4.92-.058-1.265-.08-1.644-.08-4.849 0-3.204.013-3.583.072-4.849.149-3.227 1.664-4.771 4.919-4.919C8.35 2.175 8.73 2.163 12 2.163zm0-2.163C8.741 0 8.332.014 7.052.072 2.695.272.273 2.69.073 7.052.014 8.332 0 8.741 0 12s.014 3.668.072 4.948c.2 4.358 2.618 6.78 6.98 6.98C8.332 23.986 8.741 24 12 24s3.668-.014 4.948-.072c4.354-.2 6.782-2.618 6.979-6.98C23.986 15.668 24 15.259 24 12s-.014-3.668-.073-4.948c-.2-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 1 0 12.324 6.162 6.162 0 0 1 0-12.324zM12 7.838a4.162 4.162 0 1 0 0 8.324 4.162 4.162 0 0 0 0-8.324zm6.406-1.155a1.44 1.44 0 1 1-2.881.001 1.44 1.44 0 0 1 2.881-.001z"></path>
              </svg>
            )}
          </a>
        ))}
      </nav>
      <p class="footer-tagline">{tagline}</p>
    </div>

    <div class="footer-secondary">
      <p class="copyright">© {currentYear} beek</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    padding: var(--space-5) 0 var(--space-4);
  }
  
  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-3) var(--space-4);
  }

  .footer-primary,
  .footer-secondary {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-primary {
    align-items: flex-start;
  }

  .footer-secondary {
    align-items: flex-end;
  }
  
  .footer-tagline {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin: 0;
  }
  
  .social-links {
    display: flex;
    gap: var(--space-3);
  }
  
  .social-link {
    display: flex;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: var(--color-text-secondary);
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .social-link svg {
    width: 20px;
    height: 20px;
  }

  .social-link .brand-icon {
    fill: currentColor;
  }
  
  .social-link:hover {
    color: var(--color-accent-primary);
  }

  .copyright {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin: 0;
    white-space: nowrap;
  }

  @media (max-width: 420px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
