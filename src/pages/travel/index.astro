---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import tripData from '../../data/trips.json';
import { assertValidTrip } from '@beek/shared/trip-validation';
import { haversine } from '@beek/shared/trip-runtime';
import { publicTrip } from '@beek/shared/trip-public';
import { getPhotoRolls, byDateDesc } from '../../lib/collections';
import { effectiveLocations } from '../../data/locations';

assertValidTrip(tripData);

// Everything below derives from the *published* subset. trips.json itself is
// never handed to the browser: it holds exact dates, onward legs and tentative
// stops, none of which this page may disclose.
const published = publicTrip(tripData);

// Word-preserving: separators collapse to spaces rather than vanishing, so
// matching below can require whole words. Stripping them outright made
// "Huacachina" contain "China", which linked every Chinese roll to a Peruvian
// desert oasis.
const normalizePlace = (value: string) => value
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, ' ')
  .trim();
// True when one place name contains the other as a whole run of words, so
// "Chiang Mai City Municipality" still matches the stop "Chiang Mai".
const containsWords = (haystack: string, needle: string) =>
  ` ${haystack} `.includes(` ${needle} `);
const photoRolls = (await getPhotoRolls()).sort(byDateDesc);
// Keyed by index into the published list, which is what the client indexes.
const stopPhotoLinks = Object.fromEntries(published.stops.map((stop, index) => {
  const stopName = normalizePlace(stop.name);
  const related = photoRolls.filter((roll) => effectiveLocations(roll).some((location) => {
    const names = [location.name, location.region?.name]
      .filter((name): name is string => Boolean(name))
      .map(normalizePlace);
    const nameMatch = names.some((name) => containsWords(name, stopName) || containsWords(stopName, name));
    const distance = haversine(stop, { lat: location.lat, lon: location.lng });
    return nameMatch || distance <= 80;
  })).map((roll) => ({
    href: `/photos/${roll.id}/`,
    title: roll.data.title,
  }));
  return [index, related];
}));

// Distinct rolls matched to a published stop. Derived from links already built
// above, so it discloses nothing the stop list does not.
const rollsOnRoute = new Set(
  Object.values(stopPhotoLinks).flat().map((roll) => roll.href),
).size;

const description = "Places I've been, in order — no dates, no onward plans.";
const jsonLd = {
  '@type': 'CreativeWork',
  name: tripData.meta.title,
  description,
  url: new URL('/travel/', Astro.site).href,
};
---

<BaseLayout
  title="travel"
  description={description}
  jsonLd={jsonLd}
  breadcrumbs={[
    { label: '~/beek', href: '/' },
    { label: 'travel', href: '/travel/' },
  ]}
>
  <div class="travel-page" data-travel-page>
    <div class="container">
      <div class="travel-header">
        <PageHeader title={tripData.meta.title} />
        <p class="travel-nowline"><span class="travel-pulse" aria-hidden="true"></span><span id="travel-now">loading journey…</span></p>
      </div>

      <nav class="travel-tabs" role="tablist" aria-label="Travel sections">
        <button id="travel-tab-stats" type="button" role="tab" aria-selected="false" aria-controls="travel-panel-stats" tabindex="-1" data-travel-tab="stats">stats/</button>
        <button id="travel-tab-route" type="button" role="tab" aria-selected="true" aria-controls="travel-panel-route" data-travel-tab="route">route/</button>
        <button id="travel-tab-timeline" type="button" role="tab" aria-selected="false" aria-controls="travel-panel-timeline" tabindex="-1" data-travel-tab="timeline">timeline/</button>
      </nav>

      <div class="travel-main">
        <section id="travel-panel-stats" role="tabpanel" aria-labelledby="travel-tab-stats" data-travel-panel="stats" hidden>
          <div class="travel-stats" id="travel-stats" aria-label="Trip statistics"></div>
          <div class="travel-facts" id="travel-facts"></div>
        </section>

        <section id="travel-panel-route" role="tabpanel" aria-labelledby="travel-tab-route" data-travel-panel="route">
          <div id="travel-map" class="travel-map" role="region" aria-label="Interactive map of the journey" tabindex="0"></div>
          <div class="travel-map-legend" aria-label="Map legend">
            <span><i class="legend-dot travelled"></i>been there</span>
            <span><i class="legend-dot current"></i>here now</span>
          </div>
          <div id="travel-map-stops" class="travel-map-stops" aria-label="Show a stop on the map"></div>
        </section>

        <section id="travel-panel-timeline" role="tabpanel" aria-labelledby="travel-tab-timeline" data-travel-panel="timeline" hidden>
          <div class="travel-timeline" id="travel-timeline"></div>
        </section>
      </div>
      <script id="travel-data" type="application/json" set:html={JSON.stringify({ ...published, photoLinks: stopPhotoLinks, rollsOnRoute })}></script>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/travel-client.js';
</script>

<style is:global>
  .travel-page {
    padding: var(--page-content-top) 0 var(--space-16);
  }

  .travel-header {
    padding-bottom: var(--space-4);
  }

  .travel-header .page-header {
    margin-bottom: var(--space-4);
  }

  .travel-header .page-description {
    max-width: 46rem;
  }

  .travel-nowline {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-secondary);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent-primary);
    font-size: var(--font-size-sm);
  }

  .travel-nowline b { color: var(--color-text-primary); }

  .travel-pulse {
    width: 7px;
    height: 7px;
    flex: none;
    background: var(--color-accent-primary);
    animation: travel-blink 1.8s steps(2, start) infinite;
  }

  @keyframes travel-blink { 50% { opacity: 0.35; } }

  .travel-tabs {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding: var(--space-2) 0;
    scrollbar-width: thin;
  }

  .travel-tabs button {
    flex: none;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-muted);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    font: inherit;
    font-size: var(--font-size-sm);
    cursor: pointer;
  }

  .travel-tabs button:hover,
  .travel-tabs button[aria-selected='true'] {
    color: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
  }

  .travel-tabs button[aria-selected='true'] {
    box-shadow: var(--shadow-hard-accent);
  }

  .travel-main > section { margin-top: var(--space-6); }

  .travel-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .travel-stat {
    min-width: 0;
    padding: var(--space-4);
    background: var(--color-bg-secondary);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .travel-stat strong {
    display: block;
    overflow: hidden;
    font-size: var(--font-size-2xl);
    color: var(--color-text-primary);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .travel-stat span {
    display: block;
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .travel-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  .travel-facts span { border-bottom: 1px dotted var(--color-border-strong); }
  .travel-facts b { color: var(--color-text-secondary); }

  .map-stop {
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-muted);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    font: inherit;
    font-size: var(--font-size-xs);
    cursor: pointer;
  }

  .map-stop:hover {
    color: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
  }

  .travel-map {
    height: min(62vh, 540px);
    min-height: 360px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-secondary);
    box-shadow: var(--shadow-hard);
    z-index: 0;
  }

  .travel-map .leaflet-control-attribution,
  .travel-map .leaflet-control-zoom a,
  .travel-map .leaflet-popup-content-wrapper,
  .travel-map .leaflet-popup-tip {
    color: var(--color-text-secondary);
    background: var(--color-bg-secondary);
  }

  .travel-map .leaflet-control-attribution a {
    color: var(--color-accent-tertiary);
  }

  .travel-map .leaflet-control-zoom a {
    border-color: var(--color-border);
    border-radius: 0;
  }

  .travel-map .leaflet-popup-content-wrapper {
    border: 1px solid var(--color-border-strong);
    border-radius: 0;
    box-shadow: var(--shadow-hard);
    font: var(--font-size-xs) var(--font-family);
  }

  .travel-map .leaflet-popup-content b { color: var(--color-text-primary); }
  .travel-map .popup-current { color: var(--color-accent-tertiary); }
  .travel-map .popup-muted { color: var(--color-text-muted); }

  .travel-map-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  .travel-map-legend span { display: inline-flex; align-items: center; gap: var(--space-2); }
  .legend-dot { width: 8px; height: 8px; background: var(--color-accent-primary); }
  .legend-dot.current { background: var(--color-accent-tertiary); }

  .travel-map-stops {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding-bottom: var(--space-2);
    overflow-x: auto;
  }

  .map-stop-entry {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
  }

  .map-stop.current { color: var(--color-accent-tertiary); border-color: var(--color-accent-tertiary); }

  .map-stop-photos {
    display: flex;
    max-width: 13rem;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    padding-left: var(--space-1);
    font-size: var(--font-size-xs);
  }

  .map-stop-photos a {
    color: var(--color-text-muted);
  }

  .map-stop-photos a:hover,
  .map-stop-photos a:focus-visible {
    color: var(--color-accent-primary);
  }

  .travel-timeline {
    position: relative;
    border-top: 1px solid var(--color-border);
  }

  .timeline-year {
    padding: var(--space-3) 0 var(--space-2);
    color: var(--color-accent-primary);
    font-size: var(--font-size-xs);
    letter-spacing: 0.12em;
  }

  /* Without dates the row is a single column; the 3px accent stays as the
     timeline spine, and turns cyan on the stop being published as "now". */
  .timeline-row {
    padding: var(--space-3);
    background: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent-primary);
  }

  .timeline-year + .timeline-row { border-top: 0; }

  .timeline-row.current { border-left-color: var(--color-accent-tertiary); }
  .timeline-row strong { color: var(--color-text-primary); }
  .timeline-row > span { margin-left: var(--space-2); color: var(--color-text-muted); font-size: var(--font-size-xs); }
  .timeline-row .timeline-here { color: var(--color-accent-tertiary); }
  .timeline-row .timeline-month { color: var(--color-text-secondary); letter-spacing: 0.08em; }

  .travel-empty { padding: var(--space-6); border: 1px solid var(--color-border); }

  @media (max-width: 700px) {
    .travel-stats { grid-template-columns: repeat(2, 1fr); }
    .travel-map { height: 430px; min-height: 320px; }
  }

  @media (max-width: 420px) {
    .travel-stat { padding: var(--space-3); }
    .travel-stat strong { font-size: var(--font-size-xl); }
    .travel-map { height: 380px; }
    .timeline-row { padding: var(--space-2); }
    .timeline-row > span { display: block; margin-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .travel-pulse { animation: none; }
  }
</style>
