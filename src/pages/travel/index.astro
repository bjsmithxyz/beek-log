---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import tripData from '../../data/trips.json';
import climate from '../../data/climate.json';
import { assertValidTrip } from '@beek/shared/trip-validation';
import { publicTrip } from '@beek/shared/trip-public';
import { getPhotoRolls, byDateDesc } from '../../lib/collections';
import { buildStopPhotoLinks } from '../../lib/travel-stop-photos';
import '../../styles/travel-page.css';

assertValidTrip(tripData);

// Everything below derives from the *published* subset. trips.json itself is
// never handed to the browser: it holds the live/future schedule, notes and
// tentative flags. Only completed non-tentative stays may carry exact dates.
// Climate normals are joined in here rather than fetched in the browser — the
// page reaches no origin but the map tiles, and the cache only ever answers for
// a visited place and month.
const published = publicTrip(tripData, new Date(), climate);
const photoRolls = (await getPhotoRolls()).sort(byDateDesc);
const stopPhotoLinks = buildStopPhotoLinks(published.stops, photoRolls);

const description = "Places I've been, with exact dates for completed stays, and the route ahead.";
const jsonLd = {
  '@type': 'CreativeWork',
  name: tripData.meta.title,
  description,
  url: new URL('/travel/', Astro.site).href,
};
---

<BaseLayout
  title="travel"
  description={description}
  jsonLd={jsonLd}
  breadcrumbs={[
    { label: '~/beek', href: '/' },
    { label: 'travel', href: '/travel/' },
  ]}
>
  <div class="travel-page" data-travel-page>
    <div class="container">
      <div class="travel-header">
        {/* Named as a directory, like work/ and photos/ — the itinerary's own
            meta.title stays clean for structured data. */}
        <PageHeader title={`${tripData.meta.title}/`} />
      </div>

      <nav class="travel-tabs" role="tablist" aria-label="Travel sections">
        <button id="travel-tab-stats" type="button" role="tab" aria-selected="true" aria-controls="travel-panel-stats" data-travel-tab="stats">stats/</button>
        <button id="travel-tab-route" type="button" role="tab" aria-selected="false" aria-controls="travel-panel-route" tabindex="-1" data-travel-tab="route">route/</button>
        <button id="travel-tab-timeline" type="button" role="tab" aria-selected="false" aria-controls="travel-panel-timeline" tabindex="-1" data-travel-tab="timeline">timeline/</button>
      </nav>

      <div class="travel-main">
        <section id="travel-panel-stats" role="tabpanel" aria-labelledby="travel-tab-stats" data-travel-panel="stats">
          <div class="travel-stats" id="travel-stats" aria-label="Trip statistics"></div>
          <div class="travel-facts" id="travel-facts"></div>
          <div class="travel-climate" id="travel-climate"></div>
        </section>

        <section id="travel-panel-route" role="tabpanel" aria-labelledby="travel-tab-route" data-travel-panel="route" hidden>
          <div id="travel-map" class="travel-map" role="region" aria-label="Interactive map of the journey" tabindex="0"></div>
          <div id="travel-map-stops" class="travel-map-stops" aria-label="Show a stop on the map"></div>
        </section>

        <section id="travel-panel-timeline" role="tabpanel" aria-labelledby="travel-tab-timeline" data-travel-panel="timeline" hidden>
          <div class="travel-timeline" id="travel-timeline"></div>
        </section>
      </div>
      {/* JSON.stringify leaves `<` intact; escape like JsonLd so `</script>` in stop names cannot break out. */}
      <script id="travel-data" type="application/json" set:html={JSON.stringify({ ...published, photoLinks: stopPhotoLinks }).replace(/</g, '\\u003c')}></script>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/travel-client.js';
</script>
