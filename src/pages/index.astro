---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteTree from '../components/SiteTree.astro';
import { getWorkEntries, getPhotoRolls, byDateDesc } from '../lib/collections';

const allWork = (await getWorkEntries()).sort(byDateDesc);
const allRolls = (await getPhotoRolls()).sort(byDateDesc);
const workTreeItems = allWork.map((entry) => ({
  label: `${entry.id}.md`,
  href: `/work/${entry.id}/`,
  meta: entry.data.category,
}));
const rollTreeItems = allRolls.map((entry) => ({
  label: `${entry.id}.md`,
  href: `/photos/${entry.id}/`,
  meta: entry.data.date.toISOString().slice(0, 10),
}));
---

<BaseLayout breadcrumbs={[{ label: '~/beek', href: '/' }]}>
  <section class="home">
    <div class="container">
      {/* No page title: the breadcrumb (~/beek) and the tree's own root already
          name this page, and the tree *is* the content. */}
      <SiteTree workItems={workTreeItems} rollItems={rollTreeItems} />
    </div>
  </section>
</BaseLayout>

<style>
  .home {
    padding: var(--page-content-top) 0 var(--space-16);
  }
</style>
