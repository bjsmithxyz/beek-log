---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteTree from '../components/SiteTree.astro';
import PageHeader from '../components/PageHeader.astro';
import WorkRow from '../components/WorkRow.astro';
import RollRow from '../components/RollRow.astro';
import { getWorkEntries, getPhotoRolls, byDateDesc } from '../lib/collections';

const allWork = (await getWorkEntries()).sort(byDateDesc);
const allRolls = (await getPhotoRolls()).sort(byDateDesc);
const recentWork = allWork.slice(0, 8);
const recentRolls = allRolls.slice(0, 5);
const workTreeItems = allWork.map((entry) => ({
  label: `${entry.id}.md`,
  href: `/work/${entry.id}/`,
  meta: entry.data.category,
}));
const rollTreeItems = allRolls.map((entry) => ({
  label: `${entry.id}.md`,
  href: `/photos/${entry.id}/`,
  meta: entry.data.date.toISOString().slice(0, 10),
}));
---

<BaseLayout breadcrumbs={[{ label: '~', href: '/' }]}>
  <section class="home">
    <div class="container">
      <PageHeader title="index/" description="select a path or browse recent files." />

      <SiteTree workItems={workTreeItems} rollItems={rollTreeItems} />

      <div class="recent-content">
        {recentRolls.length > 0 && (
          <section class="recent" aria-labelledby="rolls-heading">
            <div class="dir-header">
              <h2 id="rolls-heading" class="dir-path">beek/recent-rolls/</h2>
              <a href="/photos/" class="dir-link">view all →</a>
            </div>
            <div class="dir-list">
              {recentRolls.map(roll => (
                <RollRow roll={roll} />
              ))}
            </div>
          </section>
        )}

        {recentWork.length > 0 && (
          <section class="recent" aria-labelledby="recent-heading">
            <div class="dir-header">
              <h2 id="recent-heading" class="dir-path">beek/recent-work/</h2>
              <a href="/work/" class="dir-link">view all →</a>
            </div>
            <div class="dir-list">
              {recentWork.map(work => (
                <WorkRow work={work} showDescription={false} />
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home {
    padding: var(--space-10) 0 var(--space-16);
  }

  .recent-content {
    margin-top: var(--space-10);
  }

  .recent + .recent {
    margin-top: var(--space-10);
  }

  .dir-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-4);
    gap: var(--space-4);
  }

  .dir-path {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    margin: 0;
  }

  .dir-link {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .dir-link:hover {
    color: var(--color-accent-primary);
  }

  .dir-list {
    border-top: 1px solid var(--color-border);
  }
</style>
