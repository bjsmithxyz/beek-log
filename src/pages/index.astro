---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteTree from '../components/SiteTree.astro';
import WorkRow from '../components/WorkRow.astro';
import RollRow from '../components/RollRow.astro';
import { getWorkEntries, getPhotoRolls, byDateDesc } from '../lib/collections';

const allWork = (await getWorkEntries()).sort(byDateDesc);
const allRolls = (await getPhotoRolls()).sort(byDateDesc);
const recentWork = allWork.slice(0, 8);
const recentRolls = allRolls.slice(0, 5);
const totalFrames = allRolls.reduce((sum, roll) => sum + roll.data.photos.length, 0);
---

<BaseLayout breadcrumbs={[{ label: '~', href: '/' }]}>
  <section class="home">
    <div class="container">
      <header class="home-header">
        <h1 class="home-name">index/</h1>
        <p class="home-role">select a path or browse recent files.</p>
      </header>

      <SiteTree
        workCount={allWork.length}
        rollCount={allRolls.length}
        frameCount={totalFrames}
      />

      <div class="recent-content" id="recent">
        {recentRolls.length > 0 && (
          <section class="recent" aria-labelledby="rolls-heading">
            <div class="dir-header">
              <h2 id="rolls-heading" class="dir-path">beek/recent-rolls/</h2>
              <a href="/photos/" class="dir-link">view all →</a>
            </div>
            <div class="dir-list">
              {recentRolls.map(roll => (
                <RollRow roll={roll} />
              ))}
            </div>
          </section>
        )}

        {recentWork.length > 0 && (
          <section class="recent" aria-labelledby="recent-heading">
            <div class="dir-header">
              <h2 id="recent-heading" class="dir-path">beek/recent-work/</h2>
              <a href="/work/" class="dir-link">view all →</a>
            </div>
            <div class="dir-list">
              {recentWork.map(work => (
                <WorkRow work={work} showDescription={false} />
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home {
    padding: var(--space-10) 0 var(--space-16);
  }

  .home-header {
    margin-bottom: var(--space-8);
  }

  .home-name {
    font-size: var(--font-size-5xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-2);
    letter-spacing: -0.02em;
  }

  .home-role {
    font-size: var(--font-size-lg);
    color: var(--color-accent-primary);
    margin-bottom: var(--space-5);
  }

  .recent-content {
    margin-top: var(--space-10);
    scroll-margin-top: 108px;
  }

  .recent + .recent {
    margin-top: var(--space-10);
  }

  .dir-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-4);
    gap: var(--space-4);
  }

  .dir-path {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    margin: 0;
  }

  .dir-link {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .dir-link:hover {
    color: var(--color-accent-primary);
  }

  .dir-list {
    border-top: 1px solid var(--color-border);
  }
</style>
