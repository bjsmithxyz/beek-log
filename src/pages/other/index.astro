---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OtherRow from '../../components/OtherRow.astro';
import PageHeader from '../../components/PageHeader.astro';
import FilterBar from '../../components/FilterBar.astro';
import DirListHeader from '../../components/DirListHeader.astro';
import { getOtherEntries, byDateDesc } from '../../lib/collections';

const allOther = await getOtherEntries();
const sortedOther = allOther.sort(byDateDesc);
const categories = [...new Set(allOther.map(entry => entry.data.category))];

// The name column takes exactly what it needs and never wraps; the description
// takes what is left and truncates. minmax(0, 1fr) is what lets it shrink below
// its content — a bare 1fr floors at max-content and pushes the name to wrap.
const LIST_COLS = '5rem 6.5rem auto minmax(0, 1fr) 1.5rem';
---

<BaseLayout
  title="other"
  description="collection of projects, artwork, and photography"
  breadcrumbs={[
    { label: '~/beek', href: '/' },
    { label: 'other', href: '/other/' },
  ]}
>
  <section class="other-page">
    <div class="container">
      <PageHeader
        title="other/"
        description={`${sortedOther.length} entries`}
      />

      <FilterBar
        options={categories}
        rowSelector=".other-row[data-category]"
        filterAttr="data-category"
      />

      <DirListHeader
        columns={['type', 'date', 'name', 'description', '']}
        cols={LIST_COLS}
      />

      <div class="dir-list" id="other-list" style={`--dir-cols: ${LIST_COLS}`}>
        {sortedOther.map(entry => (
          <OtherRow entry={entry} />
        ))}
      </div>

      {sortedOther.length === 0 && (
        <p class="empty-state">// no entries</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .other-page {
    padding: var(--page-content-top) 0 var(--space-16);
  }
</style>
