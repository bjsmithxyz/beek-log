---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RollRow from '../../components/RollRow.astro';
import FilterBar from '../../components/FilterBar.astro';
import { Image } from 'astro:assets';
import { getPhotoRolls, byDateDesc } from '../../lib/collections';

const sortedRolls = (await getPhotoRolls()).sort(byDateDesc);

const years = [...new Set(sortedRolls.map((r) => r.data.date.getFullYear().toString()))];
const featuredPhotos = sortedRolls.flatMap((r) => r.data.photos.filter((p) => p.featured));
const totalFeatured = featuredPhotos.length;
const rollsWithFeatured = sortedRolls.filter((r) => r.data.photos.some((p) => p.featured)).length;

// A random handful of selects, fanned across the promo. Reshuffled each build.
const PROMO_THUMBS = 11;
const promoThumbs = [...featuredPhotos]
  .sort(() => Math.random() - 0.5)
  .slice(0, PROMO_THUMBS);
---

<BaseLayout
  title="photos"
  description="film photography by roll — contact sheets, stocks, and shoot locations"
  breadcrumbs={[
    { label: '~/beek', href: '/' },
    { label: 'photos', href: '/photos/' },
  ]}
>
  <section class="photos-page">
    <div class="container">
      <header class="archive-hero">
        <div class="hero-copy">
          <h1 class="page-title">photos/</h1>
        </div>
      </header>

      {totalFeatured > 0 && (
        <a class="highlights-promo" href="/photos/highlights/">
          <div class="highlights-promo-copy">
            <span class="highlights-promo-title">highlights/</span>
            <span class="highlights-promo-sub">
              {totalFeatured} {totalFeatured === 1 ? 'select' : 'selects'} across {rollsWithFeatured} {rollsWithFeatured === 1 ? 'roll' : 'rolls'}
            </span>
          </div>
          {promoThumbs.length > 0 && (
            <div class="highlights-promo-strip" aria-hidden="true">
              {promoThumbs.map((photo, i) => (
                <span
                  class="promo-thumb"
                  style={`--i:${i}; --fade:${(1 - (i / Math.max(promoThumbs.length - 1, 1)) * 0.82).toFixed(3)}`}
                >
                  <Image src={photo.src} alt="" width={120} height={120} loading="lazy" />
                </span>
              ))}
            </div>
          )}
          <span class="highlights-promo-go" aria-hidden="true">→</span>
        </a>
      )}

      <section class="rolls-section" aria-label="Film rolls">
        <div class="roll-tools">
          {years.length > 1 && (
            <FilterBar
              options={years}
              rowSelector=".roll-row[data-year]"
              filterAttr="data-year"
            />
          )}
        </div>

        <div class="dir-list is-grid">
          {sortedRolls.map((roll) => (
            <RollRow roll={roll} />
          ))}
        </div>

        {sortedRolls.length === 0 && (
          <p class="empty-state">// no rolls yet — film's still at the lab</p>
        )}
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .photos-page {
    padding: var(--page-content-top) 0 var(--space-16);
  }

  .archive-hero {
    padding: var(--space-6) 0 var(--space-6);
  }

  .hero-copy {
    max-width: 32rem;
  }

  .hero-copy .page-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    letter-spacing: -0.08em;
    line-height: 0.95;
  }

  .highlights-promo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    padding: var(--space-4);
    color: var(--color-text-primary);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-accent-primary);
    box-shadow: 0 0 0 var(--color-accent-primary);
    transition: box-shadow var(--transition-fast);
  }

  /* The box stays put; a hard accent underglow pushes out to the
     bottom-right on hover and retracts when the pointer leaves. */
  .highlights-promo:hover {
    color: var(--color-text-primary);
    box-shadow: 5px 5px 0 var(--color-accent-primary);
  }

  .highlights-promo-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 0 0 auto;
  }

  /* A fanned row of selects: overlapping left-to-right, each one fading
     further toward the arrow. Decorative, so it hides on narrow screens. */
  .highlights-promo-strip {
    display: flex;
    flex: 1 1 auto;
    justify-content: flex-end;
    align-items: center;
    min-width: 0;
    overflow: visible;
  }

  .promo-thumb {
    flex: 0 0 auto;
    width: 52px;
    height: 52px;
    margin-left: -16px;
    border: 1px solid var(--color-bg-secondary);
    background: #161412;
    opacity: var(--fade);
    z-index: calc(30 - var(--i));
    transition: transform var(--transition-fast), opacity var(--transition-fast),
      border-color var(--transition-fast);
    transition-delay: calc(var(--i) * 20ms);
    will-change: transform;
  }

  .promo-thumb:first-child {
    margin-left: 0;
  }

  .promo-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Rollover: hovering the box opens the fan — every select brightens and
     lifts in a left-to-right ripple (the stagger comes from --i). */
  .highlights-promo:hover .promo-thumb {
    opacity: 1;
    transform: translateY(-5px);
  }

  /* Direct rollover on a single pic pops it forward, framed in accent. */
  .highlights-promo:hover .promo-thumb:hover {
    transform: translateY(-5px) scale(1.4);
    z-index: 40;
    border-color: var(--color-accent-primary);
    transition-delay: 0ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .promo-thumb {
      transition-delay: 0ms;
    }
  }

  .highlights-promo-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
  }

  .highlights-promo-sub {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  .highlights-promo-go {
    color: var(--color-accent-primary);
    font-size: var(--font-size-xl);
  }

  .rolls-section {
    scroll-margin-top: var(--space-5);
  }

  .roll-tools {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    min-height: 44px;
    margin-bottom: var(--space-4);
  }

  .roll-tools :global(.filters) {
    margin: 0;
  }

  :global(.dir-list.is-grid) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  :global(.dir-list.is-grid .roll-row) {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-2);
    min-width: 0;
    margin: 0;
    padding: var(--space-3);
  }

  :global(.dir-list.is-grid .roll-row .row-preview) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    margin: calc(var(--space-3) * -1) calc(var(--space-3) * -1) var(--space-2);
    width: calc(100% + var(--space-3) * 2);
  }

  :global(.dir-list.is-grid .roll-row .row-preview img) {
    width: 100%;
    height: 100%;
  }

  :global(.dir-list.is-grid .row-title) {
    overflow: visible;
    white-space: normal;
    line-height: var(--line-height-tight);
  }

  :global(.dir-list.is-grid .row-location) {
    margin-top: auto;
  }

  :global(.dir-list.is-grid .row-selects) {
    display: none;
  }

  :global(.dir-list.is-grid .row-arrow) {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    padding: var(--space-1) var(--space-2);
    color: var(--color-text-primary);
    background: rgba(12, 12, 12, 0.78);
  }

  @media (max-width: 768px) {
    .archive-hero {
      padding-bottom: var(--space-8);
    }

    .highlights-promo-strip {
      display: none;
    }

    :global(.dir-list.is-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2);
    }

    :global(.dir-list.is-grid .roll-row) {
      padding: var(--space-2);
    }

    :global(.dir-list.is-grid .roll-row .row-preview) {
      margin: calc(var(--space-2) * -1) calc(var(--space-2) * -1) var(--space-2);
      width: calc(100% + var(--space-2) * 2);
    }
  }

  @media (max-width: 420px) {
    :global(.dir-list.is-grid) {
      grid-template-columns: 1fr;
    }
  }
</style>
