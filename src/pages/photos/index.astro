---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import RollRow from '../../components/RollRow.astro';
import WorldMap from '../../components/WorldMap.astro';
import FilterBar from '../../components/FilterBar.astro';
import { getFilmStock } from '@beek/shared/film-stocks';
import DirListHeader from '../../components/DirListHeader.astro';
import { getPhotoRolls, byDateDesc } from '../../lib/collections';
import { formatListDate } from '../../lib/dates';
import { aggregatePins } from '../../data/locations';

const sortedRolls = (await getPhotoRolls()).sort(byDateDesc);

const totalFrames = sortedRolls.reduce((sum, r) => sum + r.data.photos.length, 0);
const years = [...new Set(sortedRolls.map((r) => r.data.date.getFullYear().toString()))];

// Plot each effective shoot location, not the broad country/region centroid.
const pins = aggregatePins(sortedRolls, { groupByRegion: false });
const latestRoll = sortedRolls[0];
const latestPhoto = latestRoll?.data.photos[0];
const latestFilm = latestRoll ? getFilmStock(latestRoll.data.stock) : null;
const stockCount = new Set(sortedRolls.map((roll) => roll.data.stock)).size;
const stockSummary = [...sortedRolls.reduce((counts, roll) => {
  counts.set(roll.data.stock, (counts.get(roll.data.stock) ?? 0) + 1);
  return counts;
}, new Map<string, number>())]
  .map(([slug, count]) => ({ film: getFilmStock(slug), count }))
  .sort((a, b) => b.count - a.count || a.film.name.localeCompare(b.film.name));
const maxStockRolls = stockSummary[0]?.count ?? 1;
const framesByYear = sortedRolls.reduce((counts, roll) => {
  const year = roll.data.date.getFullYear().toString();
  counts.set(year, (counts.get(year) ?? 0) + roll.data.photos.length);
  return counts;
}, new Map<string, number>());
const yearSummary = years.map((year) => ({
  year,
  rolls: sortedRolls.filter((roll) => roll.data.date.getFullYear().toString() === year).length,
  frames: framesByYear.get(year) ?? 0,
}));
const locationSummary = [...pins.reduce((locations, pin) => {
  const key = pin.label.toLowerCase();
  const current = locations.get(key);
  if (current) current.count += pin.count;
  else locations.set(key, { label: pin.label, count: pin.count });
  return locations;
}, new Map<string, { label: string; count: number }>()).values()]
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
const maxYearFrames = Math.max(...yearSummary.map((item) => item.frames), 1);
const maxLocationFrames = locationSummary[0]?.count ?? 1;
const LIST_COLS = '5.5rem 12rem 6.5rem 1fr 11rem 1.5rem';
---

<BaseLayout
  title="photos"
  description="film photography by roll — contact sheets, stocks, and shoot locations"
  breadcrumbs={[
    { label: '~/beek', href: '/' },
    { label: 'photos', href: '/photos/' },
  ]}
>
  <section class="photos-page">
    <div class="container">
      <header class="archive-hero">
        <div class="hero-copy">
          <h1 class="page-title">photos/</h1>
          <div class="hero-actions">
            {latestRoll && (
              <a class="hero-action hero-action-primary" href={`/photos/${latestRoll.id}/`}>
                open latest roll <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>

        {latestRoll && latestPhoto && latestFilm && (
          <a class="hero-frame" href={`/photos/${latestRoll.id}/`} aria-label={`Open latest roll: ${latestRoll.data.title}`}>
            <Image
              src={latestPhoto.src}
              alt={latestPhoto.alt || latestRoll.data.title}
              width={720}
              height={480}
              loading="eager"
            />
            <span class="hero-frame-label">
              <span><b>latest exposure</b> / {latestFilm.name}</span>
              <span>{latestRoll.data.title}</span>
            </span>
            <span class="hero-frame-corner" aria-hidden="true">01</span>
          </a>
        )}
      </header>

      <div class="archive-stats" aria-label="Archive statistics">
        <button class="stat-card" type="button" data-insight="rolls" aria-expanded="false" aria-controls="archive-breakdown">
          <strong>{sortedRolls.length}</strong>
          <span class="stat-label">rolls <span class="stat-arrow" aria-hidden="true">↓</span></span>
        </button>
        <button class="stat-card" type="button" data-insight="frames" aria-expanded="false" aria-controls="archive-breakdown">
          <strong>{totalFrames}</strong>
          <span class="stat-label">frames <span class="stat-arrow" aria-hidden="true">↓</span></span>
        </button>
        <button class="stat-card" type="button" data-insight="locations" aria-expanded="false" aria-controls="archive-breakdown">
          <strong>{pins.length}</strong>
          <span class="stat-label">locations <span class="stat-arrow" aria-hidden="true">↓</span></span>
        </button>
        <button class="stat-card" type="button" data-insight="stocks" aria-expanded="false" aria-controls="archive-breakdown">
          <strong>{stockCount}</strong>
          <span class="stat-label">film stocks <span class="stat-arrow" aria-hidden="true">↓</span></span>
        </button>
      </div>

      <section class="archive-breakdown" id="archive-breakdown" aria-labelledby="archive-breakdown-heading" hidden>
        <div class="breakdown-heading">
          <h2 id="archive-breakdown-heading">film stocks</h2>
        </div>
        <div class="breakdown-body" data-breakdown-body></div>
      </section>

      <template data-insight-template="stocks">
        <ul class="insight-list">
          {stockSummary.map(({ film, count }) => (
            <li>
              <span class="insight-name" data-type={film.type}>[{film.name}]</span>
              <span class="insight-bar" aria-hidden="true"><i style={`width: ${(count / maxStockRolls) * 100}%`}></i></span>
              <strong>{count}</strong>
              <span class="insight-count">{count === 1 ? 'roll' : 'rolls'}</span>
            </li>
          ))}
        </ul>
      </template>

      <template data-insight-template="locations">
        <ul class="insight-list">
          {locationSummary.map((pin) => (
            <li>
              <span class="insight-name">{pin.label}</span>
              <span class="insight-bar" aria-hidden="true"><i style={`width: ${(pin.count / maxLocationFrames) * 100}%`}></i></span>
              <strong>{pin.count}</strong>
              <span class="insight-count">{pin.count === 1 ? 'frame' : 'frames'}</span>
            </li>
          ))}
        </ul>
      </template>

      <template data-insight-template="frames">
        <ul class="insight-list">
          {yearSummary.map(({ year, frames }) => (
            <li>
              <span class="insight-name">{year}</span>
              <span class="insight-bar" aria-hidden="true"><i style={`width: ${(frames / maxYearFrames) * 100}%`}></i></span>
              <strong>{frames}</strong>
              <span class="insight-count">frames</span>
            </li>
          ))}
        </ul>
      </template>

      <template data-insight-template="rolls">
        <ul class="insight-list roll-insight-list">
          {yearSummary.map(({ year, rolls, frames }) => (
            <li>
              <span class="insight-name">{year}</span>
              <span class="insight-detail">{rolls} {rolls === 1 ? 'roll' : 'rolls'} · {frames} frames</span>
              <button type="button" class="insight-jump" data-year-jump={year}>view year →</button>
            </li>
          ))}
        </ul>
      </template>

      {pins.length > 0 && (
        <section class="map-section" aria-labelledby="map-heading">
          <div class="section-heading">
            <div>
              <h2 id="map-heading" class="section-label">map/</h2>
            </div>
            <span class="section-index" aria-hidden="true">01</span>
          </div>
          <WorldMap pins={pins} />
        </section>
      )}

      <section class="rolls-section" aria-labelledby="rolls-heading">
        <div class="section-heading rolls-heading">
          <div>
            <h2 id="rolls-heading" class="section-label">rolls/</h2>
          </div>
          <span class="section-index" aria-hidden="true">02</span>
        </div>

        <div class="roll-tools">
          {years.length > 1 && (
            <FilterBar
              options={years}
              rowSelector=".roll-row[data-year]"
              filterAttr="data-year"
            />
          )}
          <div class="view-tools" aria-label="Archive view options">
            <button type="button" class="filter-btn view-btn active" data-view="rows" aria-pressed="true">[rows]</button>
            <button type="button" class="filter-btn view-btn" data-view="grid" aria-pressed="false">[contact sheet]</button>
          </div>
        </div>

        <DirListHeader
          columns={['preview', 'film', 'date', 'roll', 'location', '']}
          cols={LIST_COLS}
        />

        <div class="dir-list" id="roll-list" style={`--dir-cols: ${LIST_COLS}`}>
          {sortedRolls.map((roll) => (
            <RollRow roll={roll} />
          ))}
        </div>

        {sortedRolls.length === 0 && (
          <p class="empty-state">// no rolls yet — film's still at the lab</p>
        )}
      </section>
    </div>
  </section>

  <script>
    function setupArchiveControls() {
      const list = document.getElementById('roll-list');
      if (!list || list.dataset.archiveReady === 'true') return;
      list.dataset.archiveReady = 'true';

      const viewButtons = document.querySelectorAll<HTMLButtonElement>('[data-view]');
      const listHeader = list.previousElementSibling;
      const insightButtons = document.querySelectorAll<HTMLButtonElement>('[data-insight]');
      const insightPanel = document.getElementById('archive-breakdown');
      const insightHeading = document.getElementById('archive-breakdown-heading');
      const insightBody = document.querySelector<HTMLElement>('[data-breakdown-body]');
      const insightClose = document.querySelector<HTMLButtonElement>('[data-insight-close]');
      const insightTitles: Record<string, string> = {
        rolls: 'rolls by year',
        frames: 'frames by year',
        locations: 'frames by location',
        stocks: 'film stocks',
      };
      let openInsight = '';
      const closeInsight = () => {
        if (!insightPanel) return;
        openInsight = '';
        insightPanel.hidden = true;
        insightPanel.classList.remove('is-open');
        insightButtons.forEach((button) => button.setAttribute('aria-expanded', 'false'));
      };
      const showInsight = (key: string) => {
        if (!insightPanel || !insightHeading || !insightBody) return;
        const template = document.querySelector<HTMLTemplateElement>(`[data-insight-template="${key}"]`);
        if (!template) return;
        openInsight = key;
        insightHeading.textContent = insightTitles[key] || key;
        insightBody.replaceChildren(template.content.cloneNode(true));
        insightPanel.hidden = false;
        insightPanel.classList.remove('is-open');
        requestAnimationFrame(() => insightPanel.classList.add('is-open'));
        insightButtons.forEach((button) => button.setAttribute('aria-expanded', String(button.dataset.insight === key)));
      };
      insightButtons.forEach((button) => button.addEventListener('click', () => {
        if (openInsight === button.dataset.insight) closeInsight();
        else showInsight(button.dataset.insight || '');
      }));
      insightClose?.addEventListener('click', closeInsight);
      insightBody?.addEventListener('click', (event) => {
        const target = event.target as Element;
        const jump = target.closest<HTMLButtonElement>('[data-year-jump]');
        if (!jump) return;
        const year = jump.dataset.yearJump;
        document.querySelector<HTMLButtonElement>(`.filter-btn[data-filter="${year}"]`)?.click();
        closeInsight();
        requestAnimationFrame(() => {
          document.querySelector<HTMLElement>(`.roll-row[data-year="${year}"]`)
            ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      const setView = (view: string) => {
        list.classList.toggle('is-grid', view === 'grid');
        listHeader?.classList.toggle('is-hidden', view === 'grid');
        viewButtons.forEach((button) => {
          const active = button.dataset.view === view;
          button.classList.toggle('active', active);
          button.setAttribute('aria-pressed', String(active));
        });
        try { localStorage.setItem('photo-view', view); } catch { /* storage can be blocked */ }
      };

      let savedView = 'rows';
      try { savedView = localStorage.getItem('photo-view') || 'rows'; } catch { /* storage can be blocked */ }
      setView(savedView === 'grid' ? 'grid' : 'rows');
      viewButtons.forEach((button) => button.addEventListener('click', () => setView(button.dataset.view || 'rows')));
    }

    setupArchiveControls();
    document.addEventListener('astro:page-load', setupArchiveControls);
  </script>
</BaseLayout>

<style>
  .photos-page {
    padding: var(--page-content-top) 0 var(--space-16);
  }

  .archive-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.92fr);
    gap: clamp(var(--space-6), 8vw, var(--space-10));
    align-items: center;
    min-height: 390px;
    padding: var(--space-6) 0 var(--space-8);
  }

  .hero-copy {
    max-width: 32rem;
  }

  .hero-copy .page-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    letter-spacing: -0.08em;
    line-height: 0.95;
    margin-bottom: var(--space-6);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-action {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 44px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-strong);
    font: inherit;
    font-size: var(--font-size-sm);
    cursor: pointer;
    transition: transform var(--transition-fast), background var(--transition-fast), color var(--transition-fast);
  }

  .hero-action:hover {
    color: var(--color-bg-primary);
    background: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-hard-accent);
  }

  .hero-action-primary {
    color: var(--color-bg-primary);
    background: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
  }

  .hero-action-primary:hover {
    color: var(--color-bg-primary);
  }

  .hero-action-quiet {
    color: var(--color-text-primary);
    background: var(--color-bg-secondary);
  }

  .hero-frame {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    padding: 7px;
    background: #161412;
    border: 1px solid var(--color-border-strong);
    box-shadow: 8px 8px 0 var(--color-border);
    transform: rotate(1.2deg);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .hero-frame:hover {
    color: var(--color-text-primary);
    transform: rotate(0) translate(-2px, -2px);
    box-shadow: 10px 10px 0 var(--color-accent-secondary);
  }

  .hero-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid #000;
  }

  .hero-frame-label {
    position: absolute;
    right: 7px;
    bottom: 7px;
    left: 7px;
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-primary);
    background: rgba(12, 12, 12, 0.88);
    border-top: 1px solid var(--color-accent-secondary);
    font-size: var(--font-size-xs);
  }

  .hero-frame-label span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-text-secondary);
    text-align: right;
  }

  .hero-frame-label b {
    color: var(--color-accent-secondary);
    font-weight: var(--font-weight-medium);
  }

  .hero-frame-corner {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 2px 4px;
    color: var(--color-accent-secondary);
    background: rgba(12, 12, 12, 0.78);
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
  }

  .archive-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: var(--space-4) 0;
  }

  .archive-stats > * {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: 82px;
    padding: var(--space-3) var(--space-4);
  }

  .archive-stats .stat-card {
    color: inherit;
    font: inherit;
    text-align: left;
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: background var(--transition-fast);
  }

  .archive-stats .stat-card:hover,
  .archive-stats .stat-card[aria-expanded='true'] {
    background: var(--color-bg-tertiary);
  }

  .archive-stats strong {
    color: var(--color-accent-primary);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-medium);
    line-height: 1;
  }

  .archive-stats span {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    letter-spacing: 0.04em;
  }

  .stat-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: auto;
  }

  .stat-arrow {
    color: var(--color-accent-secondary) !important;
    transition: transform var(--transition-fast);
  }

  .stat-card[aria-expanded='true'] .stat-arrow {
    transform: rotate(180deg);
  }

  .archive-breakdown {
    margin-bottom: var(--space-10);
    padding: var(--space-4);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-accent-secondary);
    box-shadow: 4px 4px 0 var(--color-border);
    animation: breakdown-reveal var(--transition-slow) both;
  }

  .archive-breakdown[hidden] {
    display: none;
  }

  .breakdown-heading {
    margin-bottom: var(--space-4);
  }

  .archive-breakdown h2 {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-medium);
  }

  .insight-jump {
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-secondary);
    background: transparent;
    border: 1px solid var(--color-border);
    font: inherit;
    font-size: var(--font-size-xs);
    cursor: pointer;
  }

  .insight-jump:hover {
    color: var(--color-bg-primary);
    background: var(--color-accent-secondary);
    border-color: var(--color-accent-secondary);
  }

  .insight-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-height: 23rem;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    list-style: none;
    scrollbar-color: var(--color-border-strong) transparent;
    scrollbar-width: thin;
  }

  .insight-list li {
    display: grid;
    grid-template-columns: minmax(150px, 1fr) minmax(90px, 2.2fr) auto auto;
    gap: var(--space-3);
    align-items: center;
    min-height: 30px;
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
  }

  .insight-name {
    overflow: hidden;
    color: var(--color-accent-secondary) !important;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .insight-name[data-type='bw'] {
    color: var(--color-text-secondary) !important;
  }

  .insight-bar {
    display: block;
    height: 7px;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
  }

  .insight-bar i {
    display: block;
    height: 100%;
    background: var(--color-accent-secondary);
  }

  .insight-list li strong {
    color: var(--color-text-primary);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
  }

  .insight-count {
    min-width: 2.5rem;
    color: var(--color-text-muted) !important;
    text-align: right;
  }

  .roll-insight-list li {
    grid-template-columns: 5rem 1fr auto;
  }

  .insight-detail {
    color: var(--color-text-secondary);
  }

  .insight-jump {
    padding: var(--space-1) var(--space-2);
    color: var(--color-accent-primary);
    border-color: var(--color-border);
  }

  @keyframes breakdown-reveal {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .archive-breakdown[hidden] + .map-section,
  .archive-breakdown[hidden] + .rolls-section {
    margin-top: var(--space-6);
  }

  .map-section {
    margin-bottom: var(--space-10);
  }

  .section-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .section-label {
    margin-bottom: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
  }

  .section-note {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  .section-index {
    color: var(--color-accent-secondary);
    font-size: var(--font-size-xs);
    letter-spacing: 0.12em;
  }

  .rolls-section {
    scroll-margin-top: var(--space-5);
  }

  .rolls-heading {
    margin-top: var(--space-2);
  }

  .roll-tools {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    min-height: 44px;
    margin-bottom: var(--space-4);
  }

  .roll-tools :global(.filters) {
    margin: 0;
  }

  .view-tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }

  .view-btn {
    padding: var(--space-2);
  }

  :global(.list-header.is-hidden) {
    display: none;
  }

  :global(.dir-list.is-grid) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  :global(.dir-list.is-grid .roll-row) {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-2);
    min-width: 0;
    margin: 0;
    padding: var(--space-3);
  }

  :global(.dir-list.is-grid .roll-row .row-preview) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    margin: calc(var(--space-3) * -1) calc(var(--space-3) * -1) var(--space-2);
    width: calc(100% + var(--space-3) * 2);
  }

  :global(.dir-list.is-grid .roll-row .row-preview img) {
    width: 100%;
    height: 100%;
  }

  :global(.dir-list.is-grid .row-title) {
    overflow: visible;
    white-space: normal;
    line-height: var(--line-height-tight);
  }

  :global(.dir-list.is-grid .row-location) {
    margin-top: auto;
  }

  :global(.dir-list.is-grid .row-arrow) {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    padding: var(--space-1) var(--space-2);
    color: var(--color-text-primary);
    background: rgba(12, 12, 12, 0.78);
  }

  @media (max-width: 768px) {
    .archive-hero {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      padding-bottom: var(--space-8);
