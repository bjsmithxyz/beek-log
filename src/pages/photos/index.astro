---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import RollRow from '../../components/RollRow.astro';
import FilterBar from '../../components/FilterBar.astro';
import DirListHeader from '../../components/DirListHeader.astro';
import { getPhotoRolls, byDateDesc } from '../../lib/collections';

const sortedRolls = (await getPhotoRolls()).sort(byDateDesc);

const years = [...new Set(sortedRolls.map((r) => r.data.date.getFullYear().toString()))];
const totalFeatured = sortedRolls.reduce(
  (sum, r) => sum + r.data.photos.filter((p) => p.featured).length,
  0
);
const rollsWithFeatured = sortedRolls.filter((r) => r.data.photos.some((p) => p.featured)).length;
const latestRoll = sortedRolls[0];
const latestPhoto = latestRoll?.data.photos[0];
const LIST_COLS = '5.5rem 12rem 6.5rem 1fr 11rem 2.75rem 1.5rem';
---

<BaseLayout
  title="photos"
  description="film photography by roll — contact sheets, stocks, and shoot locations"
  breadcrumbs={[
    { label: '~/beek', href: '/' },
    { label: 'photos', href: '/photos/' },
  ]}
>
  <section class="photos-page">
    <div class="container">
      <header class="archive-hero">
        <div class="hero-copy">
          <h1 class="page-title">photos/</h1>
        </div>

        {latestRoll && latestPhoto && (
          <a class="hero-frame" href={`/photos/${latestRoll.id}/`} aria-label={`Open latest roll: ${latestRoll.data.title}`}>
            <Image
              src={latestPhoto.src}
              alt={latestPhoto.alt || latestRoll.data.title}
              width={480}
              height={320}
              loading="eager"
            />
            <span class="hero-frame-label">{latestRoll.data.title}</span>
          </a>
        )}
      </header>

      {totalFeatured > 0 && (
        <a class="highlights-promo" href="/photos/highlights/">
          <div class="highlights-promo-copy">
            <span class="highlights-promo-label">new</span>
            <span class="highlights-promo-title">highlights/</span>
            <span class="highlights-promo-sub">
              {totalFeatured} {totalFeatured === 1 ? 'select' : 'selects'} across {rollsWithFeatured} {rollsWithFeatured === 1 ? 'roll' : 'rolls'}
            </span>
          </div>
          <span class="highlights-promo-go" aria-hidden="true">→</span>
        </a>
      )}

      <section class="rolls-section" aria-label="Film rolls">
        <div class="roll-tools">
          {years.length > 1 && (
            <FilterBar
              options={years}
              rowSelector=".roll-row[data-year]"
              filterAttr="data-year"
            />
          )}
          <div class="view-tools" aria-label="Archive view options">
            <button type="button" class="filter-btn view-btn active" data-view="rows" aria-pressed="true">[rows]</button>
            <button type="button" class="filter-btn view-btn" data-view="grid" aria-pressed="false">[contact sheet]</button>
          </div>
        </div>

        <DirListHeader
          columns={['preview', 'film', 'date', 'roll', 'location', 'selects', '']}
          cols={LIST_COLS}
        />

        <div class="dir-list" id="roll-list" style={`--dir-cols: ${LIST_COLS}`}>
          {sortedRolls.map((roll) => (
            <RollRow roll={roll} />
          ))}
        </div>

        {sortedRolls.length === 0 && (
          <p class="empty-state">// no rolls yet — film's still at the lab</p>
        )}
      </section>
    </div>
  </section>

  <script>
    function setupViewToggle() {
      const list = document.getElementById('roll-list');
      if (!list || list.dataset.viewReady === 'true') return;
      list.dataset.viewReady = 'true';

      const viewButtons = document.querySelectorAll<HTMLButtonElement>('[data-view]');
      const listHeader = list.previousElementSibling;

      const setView = (view: string) => {
        list.classList.toggle('is-grid', view === 'grid');
        listHeader?.classList.toggle('is-hidden', view === 'grid');
        viewButtons.forEach((button) => {
          const active = button.dataset.view === view;
          button.classList.toggle('active', active);
          button.setAttribute('aria-pressed', String(active));
        });
        try { localStorage.setItem('photo-view', view); } catch { /* storage can be blocked */ }
      };

      let savedView = 'rows';
      try { savedView = localStorage.getItem('photo-view') || 'rows'; } catch { /* storage can be blocked */ }
      setView(savedView === 'grid' ? 'grid' : 'rows');
      viewButtons.forEach((button) => button.addEventListener('click', () => setView(button.dataset.view || 'rows')));
    }

    setupViewToggle();
    document.addEventListener('astro:page-load', setupViewToggle);
  </script>
</BaseLayout>

<style>
  .photos-page {
    padding: var(--page-content-top) 0 var(--space-16);
  }

  .archive-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(160px, 220px);
    gap: clamp(var(--space-6), 8vw, var(--space-10));
    align-items: center;
    padding: var(--space-6) 0 var(--space-6);
  }

  .hero-copy {
    max-width: 32rem;
  }

  .hero-copy .page-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    letter-spacing: -0.08em;
    line-height: 0.95;
  }

  .hero-frame {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    padding: 6px;
    background: #161412;
    border: 1px solid var(--color-border-strong);
    box-shadow: 6px 6px 0 var(--color-border);
    transform: rotate(1.2deg);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .hero-frame:hover {
    color: var(--color-text-primary);
    transform: rotate(0) translate(-2px, -2px);
    box-shadow: 10px 10px 0 var(--color-accent-secondary);
  }

  .hero-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid #000;
  }

  .hero-frame-label {
    position: absolute;
    right: 6px;
    bottom: 6px;
    left: 6px;
    overflow: hidden;
    padding: var(--space-1) var(--space-2);
    color: var(--color-text-primary);
    background: rgba(12, 12, 12, 0.88);
    border-top: 1px solid var(--color-accent-secondary);
    font-size: var(--font-size-xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .highlights-promo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    padding: var(--space-4);
    color: var(--color-text-primary);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-accent-primary);
    box-shadow: var(--shadow-hard-accent);
    transition: transform var(--transition-fast);
  }

  .highlights-promo:hover {
    color: var(--color-text-primary);
    transform: translate(-2px, -2px);
  }

  .highlights-promo-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .highlights-promo-label {
    color: var(--color-accent-primary);
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
  }

  .highlights-promo-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
  }

  .highlights-promo-sub {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  .highlights-promo-go {
    color: var(--color-accent-primary);
    font-size: var(--font-size-xl);
  }

  .rolls-section {
    scroll-margin-top: var(--space-5);
  }

  .roll-tools {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    min-height: 44px;
    margin-bottom: var(--space-4);
  }

  .roll-tools :global(.filters) {
    margin: 0;
  }

  .view-tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }

  .view-btn {
    padding: var(--space-2);
  }

  :global(.list-header.is-hidden) {
    display: none;
  }

  :global(.dir-list.is-grid) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  :global(.dir-list.is-grid .roll-row) {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-2);
    min-width: 0;
    margin: 0;
    padding: var(--space-3);
  }

  :global(.dir-list.is-grid .roll-row .row-preview) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    margin: calc(var(--space-3) * -1) calc(var(--space-3) * -1) var(--space-2);
    width: calc(100% + var(--space-3) * 2);
  }

  :global(.dir-list.is-grid .roll-row .row-preview img) {
    width: 100%;
    height: 100%;
  }

  :global(.dir-list.is-grid .row-title) {
    overflow: visible;
    white-space: normal;
    line-height: var(--line-height-tight);
  }

  :global(.dir-list.is-grid .row-location) {
    margin-top: auto;
  }

  :global(.dir-list.is-grid .row-selects) {
    display: none;
  }

  :global(.dir-list.is-grid .row-arrow) {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    padding: var(--space-1) var(--space-2);
    color: var(--color-text-primary);
    background: rgba(12, 12, 12, 0.78);
  }

  @media (max-width: 768px) {
    .archive-hero {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      padding-bottom: var(--space-8);
    }

    .hero-frame {
      width: calc(100% - 8px);
      margin-left: 2px;
    }

    .view-tools {
      width: 100%;
      margin-left: 0;
    }

    :global(.dir-list.is-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2);
    }

    :global(.dir-list.is-grid .roll-row) {
      padding: var(--space-2);
    }

    :global(.dir-list.is-grid .roll-row .row-preview) {
      margin: calc(var(--space-2) * -1) calc(var(--space-2) * -1) var(--space-2);
      width: calc(100% + var(--space-2) * 2);
    }
  }

  @media (max-width: 420px) {
    :global(.dir-list.is-grid) {
      grid-template-columns: 1fr;
    }
  }
</style>
