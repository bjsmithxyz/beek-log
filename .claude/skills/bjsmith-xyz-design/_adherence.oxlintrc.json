{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/listing/**",
              "components/media/**",
              "components/navigation/**",
              "ui_kits/admin/**",
              "ui_kits/public-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BreadcrumbItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<BreadcrumbItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|disabled|onClick|children|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, disabled, onClick, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|quiet|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'quiet' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DirListHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|cols|key|ref|className|style|children)$/]",
        "message": "<DirListHeader> doesn't accept that prop. Declared props: columns, cols."
      },
      {
        "selector": "JSXOpeningElement[name.name='DirRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:cols|href|cells|arrow|active|children|id|key|ref|className|style|children)$/]",
        "message": "<DirRow> doesn't accept that prop. Declared props: cols, href, cells, arrow, active, children, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilmFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|key|ref|className|style|children)$/]",
        "message": "<FilmFrame> doesn't accept that prop. Declared props: src, alt, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|allLabel|key|ref|className|style|children)$/]",
        "message": "<FilterBar> doesn't accept that prop. Declared props: options, value, onChange, allLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|key|ref|className|style|children)$/]",
        "message": "<FooterLink> doesn't accept that prop. Declared props: href, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='LightboxItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|full|alt|caption|meta|key|ref|className|style|children)$/]",
        "message": "<LightboxItem> doesn't accept that prop. Declared props: src, full, alt, caption, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|actions|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: title, description, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|shadow|path|title|actions|padding|children|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: tone, shadow, path, title, actions, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent|amber|blue)$/]",
        "message": "<Panel> tone must be one of 'default' | 'accent' | 'amber' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RollRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:slug|stock|stockType|date|title|location|active|href|key|ref|className|style|children)$/]",
        "message": "<RollRow> doesn't accept that prop. Declared props: slug, stock, stockType, date, title, location, active, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='RollRow'] > JSXAttribute[name.name='stockType'] > Literal[value!=/^(?:color|bw)$/]",
        "message": "<RollRow> stockType must be one of 'color' | 'bw'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TreeNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|meta|children|open|key|ref|className|style|children)$/]",
        "message": "<TreeNode> doesn't accept that prop. Declared props: label, href, meta, children, open."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|bracket|chip|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: kind, bracket, chip, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:dev|art|photography|color|bw|neutral)$/]",
        "message": "<Tag> kind must be one of 'dev' | 'art' | 'photography' | 'color' | 'bw' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:slug|category|date|description|showDescription|href|key|ref|className|style|children)$/]",
        "message": "<WorkRow> doesn't accept that prop. Declared props: slug, category, date, description, showDescription, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkRow'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:dev|art|photography)$/]",
        "message": "<WorkRow> category must be one of 'dev' | 'art' | 'photography'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapPin'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|lat|lng|count|members|slug|slugs|key|ref|className|style|children)$/]",
        "message": "<MapPin> doesn't accept that prop. Declared props: label, lat, lng, count, members, slug, slugs."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
